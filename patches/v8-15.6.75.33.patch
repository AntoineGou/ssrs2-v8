+// SSRS2: Date.UTC of number constants (a page's loop bound, written as its date) folded into its value, worked out as
+// BUILTIN(DateUTC) works it out (ToNumber of a number is the number: nothing observable is left out).
+Reduction JSCallReducer::ReduceDateUTC(Node* node) {
+  JSCallNode n(node);
+  int const argc = n.ArgumentCount();
+  if (argc < 1 || argc > 7) return NoChange();
+  double fields[7] = {std::numeric_limits<double>::quiet_NaN(), 0, 1, 0, 0, 0, 0};
+  for (int i = 0; i < argc; i++) {
+    NumberMatcher m(n.Argument(i));
+    if (!m.HasResolvedValue()) return NoChange();
+    fields[i] = m.ResolvedValue();
+  }
+  double year = fields[0];
+  if (!std::isnan(year)) {
+    double const y = DoubleToInteger(year);
+    if (0.0 <= y && y <= 99) year = 1900 + y;
+  }
+  double value = MakeDate(MakeDay(year, fields[1], fields[2]),
+                          MakeTime(fields[3], fields[4], fields[5], fields[6]));
+  if (!DateCache::TryTimeClip(&value)) {
+    value = std::numeric_limits<double>::quiet_NaN();
+  }
+  Node* result = jsgraph()->ConstantNoHole(value);
+  ReplaceWithValue(node, result, n.effect(), n.control());
+  return Replace(result);
+}
