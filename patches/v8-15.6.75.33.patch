+          simplified()->CheckNumber(p.feedback()), n.receiver(), effect, control);
+      Node* ax = graph()->NewNode(simplified()->NumberAbs(), x);
+      Node* fits = op(simplified()->NumberLessThan(),
+                      op(simplified()->NumberMultiply(), ax, pow),
+                      jsgraph()->ConstantNoHole(4503599627370496.0));
+      effect = graph()->NewNode(
+          simplified()->CheckIf(DeoptimizeReason::kLostPrecision, p.feedback()),
+          fits, effect, control);
+      Node* ip = graph()->NewNode(simplified()->NumberFloor(), ax);
+      Node* r = op(simplified()->NumberSubtract(), ax, ip);
+      Node* hi = op(simplified()->NumberMultiply(), r, pow);
+      Node* big = op(simplified()->NumberMultiply(),
+                     jsgraph()->ConstantNoHole(134217729.0), r);
+      Node* rh = op(simplified()->NumberSubtract(), big,
+                    op(simplified()->NumberSubtract(), big, r));
+      Node* rl = op(simplified()->NumberSubtract(), r, rh);
+      Node* lo = op(
+          simplified()->NumberAdd(),
+          op(simplified()->NumberAdd(),
+             op(simplified()->NumberAdd(),
+                op(simplified()->NumberSubtract(),
