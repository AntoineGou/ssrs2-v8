+                         op(simplified()->NumberSubtract(), hi, n0),
+                         jsgraph()->ConstantNoHole(0.5)),
+                      lo);
+      Node* rounded = graph()->NewNode(
+          common()->Select(MachineRepresentation::kTagged),
