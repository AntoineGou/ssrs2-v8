+    // receiver that is no number, or |x| * 10^f past 2^52 (NaN too), deoptimizes; the call site's next code then
+    // calls NumberToFixedNumber.
+    std::vector<Node*> cases;
+    if (digits->opcode() == IrOpcode::kPhi) {
+      for (int i = 0; i < digits->op()->ValueInputCount(); i++) {
+        cases.push_back(NodeProperties::GetValueInput(digits, i));
+      }
+    } else {
+      cases.push_back(digits);
+    }
+    std::vector<Node*> pows, pow_highs, pow_lows;
+    bool in_range = true;
+    for (Node* c : cases) {
+      double const f = NumberMatcher(c).ResolvedValue();
+      if (!(f >= 0 && f <= 20) || f != std::floor(f)) {
+        in_range = false;
+        break;
+      }
+      // (10^f as the builtin works it out, and Dekker's split of it)
+      double pw = 1;
