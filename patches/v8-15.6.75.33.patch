+// NumberToFixedNumber's: the number ToNumber would read, else the call itself and then ToNumber.
+Reduction JSCallReducer::ReduceNumberPrototypeToFixed(Node* node) {
+  JSCallNode n(node);
+  CallParameters const& p = n.Parameters();
+  if (n.ArgumentCount() != 1) return NoChange();
+  if (NodeProperties::IsExceptionalCall(node)) return NoChange();
+  Node* digits = n.Argument(0);
+  bool to_number = false;
+  for (Edge edge : node->use_edges()) {
+    if (!NodeProperties::IsValueEdge(edge)) continue;
+    Node* const user = edge.from();
+    if (user->opcode() == IrOpcode::kJSToNumber && edge.index() == 0) {
+      to_number = true;
+      continue;
+    }
+    if (user->opcode() == IrOpcode::kFrameState &&
+        edge.index() == FrameState::kFrameStateStackInput) {
+      continue;
+    }
+    return NoChange();
+  }
