+// SSRS2: Microsoft's C++ library declares std::atomic<T> with an explicit alignment, which #pragma pack does not lower,
+// so ExtendedMap (pack(1)) took 4-byte alignment from Map and was 76 bytes where V8's Torque layout has 73
+// (JSInterceptorMap's fields at 76 for 73). There, Map's wider atomics are their plain types, read and written through
+// std::atomic_ref (Map only loads and stores them).
+#if defined(_MSVC_STL_VERSION)
+template <typename T>
+class MapAtomic {
+ public:
+  T load(std::memory_order order = std::memory_order_seq_cst) const {
+    return std::atomic_ref<T>(const_cast<T&>(value_)).load(order);
+  }
+  void store(T value, std::memory_order order = std::memory_order_seq_cst) {
+    std::atomic_ref<T>(value_).store(value, order);
+  }
+
+ private:
+  T value_;
+};
+#else
+template <typename T>
+using MapAtomic = std::atomic<T>;
+#endif
