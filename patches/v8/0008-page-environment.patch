+MathRandom::State MathRandom::Ssrs2Seeded(uint32_t seed) {
+  Ssrs2Words w;
+  w.s0 = seed != 0 ? seed : 0x9E3779B9u;
+  w.s1 = 0x243F6A88u ^ w.s0;
+  w.s2 = 0xB7E15162u;
+  w.s3 = 0x6A09E667u ^ (seed * 31u);
+  for (int i = 0; i < 16; i++) Ssrs2Next32(&w);
+  return Ssrs2Pack(w);
+}
+
+double MathRandom::Ssrs2Next(State* state) {
+  Ssrs2Words w = Ssrs2Unpack(*state);
+  uint64_t high = Ssrs2Next32(&w);
+  uint64_t low = Ssrs2Next32(&w) >> 11;
+  *state = Ssrs2Pack(w);
+  return static_cast<double>((high << 21) | low) / 9007199254740992.0;
+}
