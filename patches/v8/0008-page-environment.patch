+std::string Intl::Ssrs2CanonicalTimeZone(Isolate* isolate,
+                                         const std::string& name,
+                                         bool* known) {
+  *known = true;
+  std::string lower(name);
+  std::transform(lower.begin(), lower.end(), lower.begin(), ToAsciiLower);
+  if (lower.empty() || lower == "utc" || lower == "etc/utc" ||
+      lower == "etc/gmt" || lower == "gmt" || lower == "z") {
+    return std::string();
+  }
+  DirectHandle<String> given;
+  if (!isolate->factory()
+           ->NewStringFromUtf8(base::CStrVector(name.c_str()))
+           .ToHandle(&given)) {
+    *known = false;
+    return std::string();
+  }
+  std::unique_ptr<icu::TimeZone> tz =
+      JSDateTimeFormat::CreateTimeZone(isolate, given);
+  if (!tz) {
+    *known = false;
+    return std::string();
+  }
+  icu::UnicodeString id;
+  tz->getID(id);
+  std::string canonical;
+  id.toUTF8String(canonical);
+  return canonical == "UTC" || canonical == "Etc/UTC" ? std::string()
+                                                      : canonical;
+}
