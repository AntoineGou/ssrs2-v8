+void MathRandom::Ssrs2Seed(Tagged<Context> native_context, uint32_t seed) {
+  DisallowGarbageCollection no_gc;
+  Cast<PodArray<State>>(native_context->math_random_state())
+      ->set(0, Ssrs2Seeded(seed));
