+struct Ssrs2Words {
+  uint32_t s0, s1, s2, s3;
+};
+
+Ssrs2Words Ssrs2Unpack(const MathRandom::State& state) {
+  return {static_cast<uint32_t>(state.s0),
+          static_cast<uint32_t>(state.s0 >> 32),
+          static_cast<uint32_t>(state.s1),
+          static_cast<uint32_t>(state.s1 >> 32)};
+}
+
+MathRandom::State Ssrs2Pack(const Ssrs2Words& w) {
+  return {static_cast<uint64_t>(w.s0) | (static_cast<uint64_t>(w.s1) << 32),
+          static_cast<uint64_t>(w.s2) | (static_cast<uint64_t>(w.s3) << 32)};
+}
+
+uint32_t Ssrs2Next32(Ssrs2Words* w) {
+  uint32_t t = w->s0 ^ (w->s0 << 11);
+  w->s0 = w->s1;
+  w->s1 = w->s2;
+  w->s2 = w->s3;
+  w->s3 = w->s3 ^ (w->s3 >> 19) ^ t ^ (t >> 8);
+  return w->s3;
+}
