+bool ssrs2::SetTimeZone(Isolate* isolate, const char* time_zone) {
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  std::string zone;
+#ifdef V8_INTL_SUPPORT
+  {
+    HandleScope scope(isolate);
+    TryCatch try_catch(isolate);
+    bool known;
+    zone = i::Intl::Ssrs2CanonicalTimeZone(
+        i_isolate, time_zone != nullptr ? time_zone : "", &known);
+    if (!known || try_catch.HasCaught()) return false;
+  }
+#else
+  if (time_zone != nullptr && *time_zone != 0) return false;
+#endif
+  i::DateCache* date_cache = i_isolate->date_cache();
+  if (zone == date_cache->ssrs2_time_zone()) return true;
+  bool const is_utc = zone.empty();
+  // Compiled code folds getUTCDate and its kin to the local fields while local time is UTC (JSCallReducer, Maglev's
+  // reducer): none compiles while that changes, and what was compiled with dates is thrown away with the protector.
+  if (is_utc != date_cache->local_time_is_utc()) {
+    i_isolate->AbortConcurrentOptimization(i::BlockingBehavior::kBlock);
+  }
+  date_cache->Ssrs2SetTimeZone(zone, is_utc);
+  i_isolate->IncreaseDateCacheStampAndInvalidateProtector();
+#ifdef V8_INTL_SUPPORT
+  i_isolate->clear_cached_icu_object(
+      i::Isolate::ICUObjectCacheType::kDefaultSimpleDateFormat);
+  i_isolate->clear_cached_icu_object(
+      i::Isolate::ICUObjectCacheType::kDefaultSimpleDateFormatForTime);
+  i_isolate->clear_cached_icu_object(
+      i::Isolate::ICUObjectCacheType::kDefaultSimpleDateFormatForDate);
+#endif
+  return true;
+}
+
+bool ssrs2::SetDefaultLocale(Isolate* isolate, const char* locale) {
+#ifdef V8_INTL_SUPPORT
+  i::Isolate* i_isolate = reinterpret_cast<i::Isolate*>(isolate);
+  std::string resolved;
+  {
+    HandleScope scope(isolate);
+    TryCatch try_catch(isolate);
+    resolved = i::Intl::Ssrs2ResolveDefaultLocale(
+        i_isolate, locale != nullptr ? locale : "");
+    if (resolved.empty() || try_catch.HasCaught()) return false;
+  }
+  if (resolved == i_isolate->DefaultLocale()) return true;
+  // (V8's own reset: the cached formatters let go, code that inlined a locale's fast paths thrown away)
+  i_isolate->ResetDefaultLocale();
+  i_isolate->set_default_locale(resolved);
+  i_isolate->date_cache()->Ssrs2ClearFormatters();
+  return true;
+#else
+  return locale == nullptr || *locale == 0;
+#endif
+}
