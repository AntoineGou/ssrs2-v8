+DirectHandle<JSObject> Intl::Ssrs2OptionsCopy(
+    Isolate* isolate, const RootIndex* names,
+    const DirectHandle<Object>* values, size_t count) {
+  DirectHandle<JSObject> read =
+      isolate->factory()->NewJSObject(isolate->object_function());
+  for (size_t i = 0; i < count; i++) {
+    if (values[i].is_null() || IsUndefined(*values[i])) continue;
+    JSObject::AddProperty(isolate, read,
+                          Cast<Name>(isolate->root_handle(names[i])),
+                          values[i], NONE);
+  }
+  return read;
+}
