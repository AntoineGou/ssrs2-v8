+// SSRS2: a value in a formatter's key: its type, its text's length and its text (a small integer, a boolean or a
+// flat string written as it is, without a string made of it).
+void Ssrs2AppendKeyValue(Isolate* isolate, std::string* key, char type,
+                         DirectHandle<Object> value) {
+  key->push_back(type);
+  if (IsSmi(*value)) {
+    std::string text = std::to_string(Smi::ToInt(*value));
+    key->append(std::to_string(text.size()));
+    key->push_back(':');
+    key->append(text);
+    return;
+  }
+  if (IsBoolean(*value)) {
+    key->append(IsTrue(*value) ? "1:t" : "1:f");
+    return;
+  }
+  std::string text =
+      (IsString(*value) ? Cast<String>(value)
+                        : Object::NoSideEffectsToString(isolate, value))
+          ->ToStdString();
+  key->append(std::to_string(text.size()));
+  key->push_back(':');
+  key->append(text);
+}
