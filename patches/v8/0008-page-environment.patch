+Maybe<bool> Intl::Ssrs2FormatterKey(Isolate* isolate, const char* kind,
+                                    DirectHandle<Object> locales,
+                                    DirectHandle<Object> options,
+                                    const RootIndex* names, size_t count,
+                                    std::string* key,
+                                    DirectHandle<Object>* values) {
+  key->assign(kind);
+  key->push_back('|');
+  if (IsUndefined(*locales)) {
+    key->push_back('u');
+  } else if (IsString(*locales)) {
+    Ssrs2AppendKeyValue(isolate, key, 's', locales);
+  } else if (IsJSArray(*locales)) {
+    DirectHandle<JSArray> list = Cast<JSArray>(locales);
+    double length = Object::NumberValue(list->length());
+    if (!(length <= 16)) return Just(false);
+    key->push_back('a');
+    key->append(std::to_string(static_cast<int>(length)));
+    for (uint32_t i = 0; i < static_cast<uint32_t>(length); i++) {
+      DirectHandle<Object> item;
+      ASSIGN_RETURN_ON_EXCEPTION_VALUE(
+          isolate, item, JSReceiver::GetElement(isolate, list, i),
+          Nothing<bool>());
+      if (!IsString(*item)) return Just(false);
+      Ssrs2AppendKeyValue(isolate, key, 's', item);
+    }
+  } else {
+    return Just(false);
+  }
+  if (IsUndefined(*options)) return Just(true);
+  if (!IsJSObject(*options) || IsJSProxy(*options)) return Just(false);
+  DirectHandle<JSReceiver> given = Cast<JSReceiver>(options);
+  for (size_t i = 0; i < count; i++) {
+    DirectHandle<Object> value;
+    ASSIGN_RETURN_ON_EXCEPTION_VALUE(
+        isolate, value,
+        JSReceiver::GetProperty(isolate, given,
+                                Cast<Name>(isolate->root_handle(names[i]))),
+        Nothing<bool>());
+    values[i] = value;
+    char type;
+    if (IsUndefined(*value)) {
+      continue;
+    } else if (IsString(*value)) {
+      type = 's';
+    } else if (IsNumber(*value)) {
+      type = 'n';
+    } else if (IsBoolean(*value)) {
+      type = 'b';
+    } else if (IsNull(*value)) {
+      type = 'z';
+    } else if (IsBigInt(*value)) {
+      type = 'i';
+    } else {
+      return Just(false);
+    }
+    key->push_back('|');
+    key->append(std::to_string(i));
+    Ssrs2AppendKeyValue(isolate, key, type, value);
+  }
+  return Just(true);
+}
