   auto stack_trace = i_isolate->GetDetailedStackTrace(js_obj);
   return Utils::StackTraceToLocal(stack_trace);
+}
+
+bool ssrs2::SetImmutableProto(Local<Object> object) {
+  auto obj = Utils::OpenDirectHandle(*object);
+  if (!i::IsJSObject(*obj)) return false;
+  auto js_obj = i::Cast<i::JSObject>(obj);
+  i::Isolate* i_isolate = i::Isolate::Current();
+  i::DirectHandle<i::Map> map(js_obj->map(), i_isolate);
+  if (map->is_immutable_proto()) return true;
+  // As JSObject::SetImmutableProto, its map copied with the bit set, but migrated as a prototype's map change is (an
+  // object already some maps' prototype: their prototype chains' validity cells invalidated), not only set.
+  i::DirectHandle<i::Map> new_map =
+      i::Map::TransitionToImmutableProto(i_isolate, map);
+  i::JSObject::MigrateToMap(i_isolate, js_obj, new_map);
+  return true;
 }
 
