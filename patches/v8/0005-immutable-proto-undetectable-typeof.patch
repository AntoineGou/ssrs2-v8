+
+namespace v8 {
+
+class Object;
+
+namespace ssrs2 {
+
+/**
+ * SSRS2: makes an existing object's prototype immutable (V8's immutable prototype map bit, which
+ * ObjectTemplate::SetImmutableProto gives a template's new objects only): its [[SetPrototypeOf]] then refuses any other
+ * prototype (WebIDL's immutable prototype exotic objects: a global's prototype chain, Window.prototype, its named
+ * properties object, EventTarget.prototype). Properties can still be added and changed. False when object is not an
+ * ordinary JS object (a proxy, an API object of another kind); true when it was or is now.
+ */
+V8_EXPORT bool SetImmutableProto(Local<Object> object);
+
+}  // namespace ssrs2
+}  // namespace v8
+
+#endif  // INCLUDE_V8_SSRS2_H_
