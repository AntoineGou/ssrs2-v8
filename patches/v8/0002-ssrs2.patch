+TNode<Number> CodeStubAssembler::TryFastDateToNumber(
+    TNode<Context> context, TNode<JSReceiver> input, Label* not_fast) {
+  TNode<NativeContext> native_context = LoadNativeContext(context);
+  TNode<JSFunction> date_function = CAST(
+      LoadContextElement(native_context, Context::DATE_FUNCTION_INDEX));
+  TNode<HeapObject> initial_map =
+      LoadJSFunctionPrototypeOrInitialMap(date_function);
+  GotoIfNot(TaggedEqual(LoadMap(input), initial_map), not_fast);
+  TNode<Object> cell_value = LoadObjectField(
+      DateToPrimitiveProtectorConstant(), offsetof(PropertyCell, value_));
+  GotoIf(TaggedEqual(cell_value, SmiConstant(Protectors::kProtectorInvalid)),
+         not_fast);
+  return ChangeFloat64ToTagged(
+      LoadObjectField<Float64T>(input, offsetof(JSDate, value_)));
+}
