+/**
+ * SSRS2: makes an object changed in setup mode fast again, once: a prototype V8 keeps fast (inline caches used it) as
+ * V8 does, any other object in dictionary mode too (redefining an accessor normalized it). True when it has fast
+ * properties now; false when it is not an ordinary object (a global, a proxy) or has too many properties.
+ */
+V8_EXPORT bool OptimizePrototype(Local<Object> object);
