@@ -234,6 +234,14 @@ namespace Microsoft.ClearScript.Util
             return builder.ToString();
         }
 
+        // SSRS2: a compiled script's digest is read by CommonJS modules alone (V8ScriptEngine.ExecuteInternal,
+        // CommonJSManager.GetOrCreateModule); for any other document its whole text was hashed a byte a step at
+        // every Compile and the digest never read.
+        public static UIntPtr GetDigest(this string code, UniqueDocumentInfo documentInfo)
+        {
+            return (documentInfo.Category == JavaScript.ModuleCategory.CommonJS) ? code.GetDigest() : UIntPtr.Zero;
+        }
+
         public static UIntPtr GetDigest(this string code)
         {
             return (UIntPtr.Size == 4) ? (UIntPtr)code.GetDigestAsUInt32() : (UIntPtr)code.GetDigestAsUInt64();
