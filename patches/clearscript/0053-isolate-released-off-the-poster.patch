+    // SSRS2 (0053): lets this reference go unless it is the target's last one, which it then keeps (no teardown here):
+    // true when let go.
+    bool ReleaseUnlessLast()
+    {
+        if (m_pTarget == nullptr)
+        {
+            return true;
+        }
+
+        if (!m_pRefCount->DecrementUnlessLast())
+        {
+            return false;
+        }
+
+        m_pTarget = nullptr;
+        m_pRefCount = nullptr;
+        return true;
+    }
+
     ~SharedPtr()
     {
         Release();
diff --git a/ClearScriptV8/V8IsolateImpl.cpp b/ClearScriptV8/V8IsolateImpl.cpp
--- a/ClearScriptV8/V8IsolateImpl.cpp
+++ b/ClearScriptV8/V8IsolateImpl.cpp
@@ -338,6 +338,24 @@
 bool V8ForegroundTaskRunner::NonNestableDelayedTasksEnabled() const
 {
     return true;
+}
+
+//-----------------------------------------------------------------------------
+
+// SSRS2 (0053): a reference to an isolate taken on a thread that posts it a task is let go on the thread pool, not on
+// the posting thread. Taken from the runner's weak reference while the isolate's owner lets it go, it can be the last
+// one: the isolate was then torn down on the posting thread, under whatever lock V8 held there. WasmEngine::TriggerGC
+// posts under the process's WasmEngine mutex, and a teardown there ran the isolate's queued wasm code GC task, which
+// takes that mutex: the thread waited for itself (seen 2026-11-26 in a reproduction with 0050 and 0052).
+// Only the last reference goes to the thread pool: an earlier one is let go here at once (an isolate's own posts while
+// it is made, under its constructor's reference, among them: sent to the pool, such a reference could have been the
+// last one before the isolate's creator took its own, and the half-made isolate was destroyed).
+static void Ssrs2ReleaseOffThread(SharedPtr<V8Isolate>&& spIsolate)
+{
+    if (!spIsolate.ReleaseUnlessLast())
+    {
+        HostObjectUtil::QueueNativeCallback([spLast = std::move(spIsolate)] () mutable { spLast.Empty(); });
+    }
 }
 
