+
+// Whether a value is a Proxy, and a Proxy's target (0035): what no script can ask without running a trap (a Proxy
+// answers every operation through its handler, and a revoked one throws at each).
+//
+//   int Ssrs2_ProxyKind(int32_t context, int32_t value);
+//   int Ssrs2_ProxyTarget(int32_t context, int32_t proxy, int32_t into);
+//
+// The values are named by their handles in the context's table (0030; the context by its number, 0032, or 0 for the
+// current one). Ssrs2_ProxyKind answers 0 for a value that is no Proxy (an ordinary object, a primitive, nothing), 1
+// for a Proxy, 2 for a revoked Proxy. Ssrs2_ProxyTarget leaves the Proxy's target, as it is (itself a Proxy where a
+// Proxy wraps one: asked again), at index `into` of the same table (1 or more: the host names an index it owns, or 1,
+// the place of a call's answer, which the next call into script of that context reuses) and answers 1; 0 where the
+// value is no Proxy or a revoked one (it has no target any more): nothing is written. Both answer -1 with no isolate
+// entered on this thread, a number that names no context, a context without a handle table, a negative handle, or
+// `into` below 1. Threading: the isolate's thread, the isolate entered and locked by the caller. No trap and no
+// script runs, no callback is made: safe inside any host call or callback, and where the host reads an object's own
+// properties and must not be seen doing it.
+namespace Ssrs2Proxies
+{
+    // The value under a handle of a context: false where there is no such context, table or handle.
+    static bool Value(v8::Isolate* isolate, int32_t context, int32_t handle, v8::Local<v8::Context>* target, v8::Local<v8::Value>* value)
+    {
+        *target = Ssrs2Contexts::Find(isolate, context);
+        if (target->IsEmpty())
+        {
+            return false;
+        }
+        v8::Context::Scope contextScope(*target);
+        return Ssrs2HandleValue(isolate, handle).ToLocal(value);
+    }
+}
+
+NATIVE_ENTRY_POINT(int) Ssrs2_ProxyKind(int32_t context, int32_t value) noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr)
+    {
+        return -1;
+    }
+    v8::HandleScope scope(isolate);
+    v8::Local<v8::Context> target;
+    v8::Local<v8::Value> given;
+    if (!Ssrs2Proxies::Value(isolate, context, value, &target, &given))
+    {
+        return -1;
+    }
+    if (!given->IsProxy())
+    {
+        return 0;
+    }
+    return given.As<v8::Proxy>()->IsRevoked() ? 2 : 1;
 }
 
+NATIVE_ENTRY_POINT(int) Ssrs2_ProxyTarget(int32_t context, int32_t proxy, int32_t into) noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr || into < 1)
+    {
+        return -1;
+    }
+    v8::HandleScope scope(isolate);
+    v8::Local<v8::Context> target;
+    v8::Local<v8::Value> given;
+    if (!Ssrs2Proxies::Value(isolate, context, proxy, &target, &given))
+    {
+        return -1;
+    }
+    if (!given->IsProxy() || given.As<v8::Proxy>()->IsRevoked())
+    {
+        return 0;
+    }
+    v8::Context::Scope contextScope(target);
+    return Ssrs2HandlePut(target, into, given.As<v8::Proxy>()->GetTarget()) ? 1 : -1;
+}
