@@ -1454,16 +1454,55 @@ void V8IsolateImpl::ImportMetaInitializeCallback(v8::Local<v8::Context> hContext
 
 //-----------------------------------------------------------------------------
 
+// SSRS2: an import's type attribute (import ... with { type: "text" }, import(..., { with: { type: "json" } })) told to
+// the host with its specifier, which is all ClearScript's module loader is given: the specifier, a NUL, "type=" and the
+// type. The host's loader reads it and takes it off; a specifier without the attribute is passed as it is. A dynamic
+// import's attributes come as key-value pairs, a static import's as triples (key, value, source location).
+static v8::Local<v8::String> WithImportType(v8::Isolate* pIsolate, v8::Local<v8::Context> hContext, v8::Local<v8::String> hSpecifier, v8::Local<v8::FixedArray> hAttributes, int stride)
+{
+    if (hAttributes.IsEmpty())
+    {
+        return hSpecifier;
+    }
+
+    auto hType = v8::String::NewFromUtf8Literal(pIsolate, "type");
+    for (int index = 0; index + 1 < hAttributes->Length(); index += stride)
+    {
+        auto hKey = hAttributes->Get(index);
+        auto hValue = hAttributes->Get(index + 1);
+        if (hKey.IsEmpty() || hValue.IsEmpty() || !hKey->IsValue() || !hValue->IsValue())
+        {
+            continue;
+        }
+
+        auto hKeyValue = hKey.As<v8::Value>();
+        auto hValueValue = hValue.As<v8::Value>();
+        if (!hKeyValue->IsString() || !hValueValue->IsString() || !hKeyValue.As<v8::String>()->StringEquals(hType))
+        {
+            continue;
+        }
+
+        auto hMarker = v8::String::NewFromUtf8Literal(pIsolate, "\0type=");
+        return v8::String::Concat(pIsolate, v8::String::Concat(pIsolate, hSpecifier, hMarker), hValueValue.As<v8::String>());
+    }
+
+    return hSpecifier;
+}
