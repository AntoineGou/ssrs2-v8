+#include <algorithm>
+
+//-----------------------------------------------------------------------------
+// SSRS2 (0045): objects watched for their collection. The host names objects by their handles in the current context's
+// table (0030); when V8 collects one, its context's number and its handle are queued for the isolate, never a call into
+// the host from the collector; the host takes the queue when it likes.
+//
+//   int Ssrs2_WatchObjects(const int32_t* handles, int32_t count);
+//   int Ssrs2_CollectedObjects(int32_t* contexts, int32_t* handles, int32_t capacity);
+//
+// Ssrs2_WatchObjects (inside a host call, the context current): answers how many of the handles named an object it now
+// watches (a value that is no object, or a handle out of the table, is skipped; an object watched twice is reported
+// twice). Ssrs2_CollectedObjects: moves up to `capacity` reports into the arrays, the oldest first, and answers how many;
+// on the isolate's thread with the isolate entered. A report says the object is gone: the handle may name something else
+// by then if the script put another value there.
+//-----------------------------------------------------------------------------
+
+namespace Ssrs2Watch
+{
+    struct Watch
+    {
+        v8::Global<v8::Value> object;
+        int32_t context;
+        int32_t handle;
+        Ssrs2Recording::Isolates* owner;
+    };
+
+    static void Gone(const v8::WeakCallbackInfo<Watch>& info)
+    {
+        auto w = info.GetParameter();
+        w->object.Reset();
+        if (auto owner = w->owner)
+        {
+            owner->collected.push_back({ w->context, w->handle });
+            owner->watches.erase(w);
+        }
+        delete w;
+    }
+}
+
+NATIVE_ENTRY_POINT(int) Ssrs2_WatchObjects(const int32_t* handles, int32_t count) noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr || !isolate->InContext() || handles == nullptr || count < 0) return 0;
+    v8::HandleScope scope(isolate);
+    auto context = isolate->GetCurrentContext();
+    int32_t number = Ssrs2Contexts::NumberOf(isolate, context);
+    auto all = Ssrs2Recording::IsolatesOf(isolate, true);
+    all->watchesGone = [](Ssrs2Recording::Isolates* owner)
+    {
+        for (auto p : owner->watches) { auto w = static_cast<Ssrs2Watch::Watch*>(p); w->object.Reset(); delete w; }
+        owner->watches.clear();
+    };
+    int watched = 0;
+    for (int32_t i = 0; i < count; i++)
+    {
+        v8::Local<v8::Value> value;
+        if (!Ssrs2HandleValue(isolate, handles[i]).ToLocal(&value) || !value->IsObject()) continue;
+        auto w = new Ssrs2Watch::Watch{ v8::Global<v8::Value>(isolate, value), number, handles[i], all };
+        w->object.SetWeak(w, Ssrs2Watch::Gone, v8::WeakCallbackType::kParameter);
+        all->watches.insert(w);
+        watched++;
+    }
+    return watched;
+}
+
+NATIVE_ENTRY_POINT(int) Ssrs2_CollectedObjects(int32_t* contexts, int32_t* handles, int32_t capacity) noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr || contexts == nullptr || handles == nullptr || capacity <= 0) return 0;
+    auto all = Ssrs2Recording::IsolatesOf(isolate, false);
+    if (all == nullptr) return 0;
+    auto& queue = all->collected;
+    int32_t n = static_cast<int32_t>(std::min<size_t>(queue.size(), static_cast<size_t>(capacity)));
+    for (int32_t i = 0; i < n; i++) { contexts[i] = queue[static_cast<size_t>(i)].first; handles[i] = queue[static_cast<size_t>(i)].second; }
+    queue.erase(queue.begin(), queue.begin() + n);
+    return n;
+}
+
