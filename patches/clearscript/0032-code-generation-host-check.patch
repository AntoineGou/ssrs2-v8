+static bool Ssrs2HandlePut(v8::Local<v8::Context> context, int32_t handle, v8::Local<v8::Value> value)
+{
+    if (context.IsEmpty() || context->GetNumberOfEmbedderDataFields() <= static_cast<uint32_t>(kSsrs2HandlesIndex) || handle < 0)
+    {
+        return false;
+    }
+    auto data = context->GetEmbedderDataV2(kSsrs2HandlesIndex);
+    if (data.IsEmpty() || !data->IsValue() || !data.As<v8::Value>()->IsArray())
+    {
+        return false;
+    }
+    // (a table the script froze, or gave a setter: no exception is left behind)
+    v8::TryCatch tryCatch(v8::Isolate::GetCurrent());
+    return data.As<v8::Array>()->Set(context, static_cast<uint32_t>(handle), value).FromMaybe(false);
+}
