+// Context numbers (0032). A host with several contexts in an isolate names one by a number the library gives it:
+//
+//   int32_t Ssrs2_ContextNumber(void);
+//
+// from inside a host call, answers the current context's number: 1 or more, the same at each ask, never given to
+// another context of the process; 0 outside a context. The exports that take a context (0032 and later) take that
+// number, or 0 for the current context, and a host callback is told the number of the context it is asked for. A
+// number names its context until the context is torn down (its engine disposed) or collected: after that an export
+// answers as it does where there is no context, and no callback is called for it. The numbers of an isolate's
+// contexts are kept by the isolate (its data slot 2: a table of weak references, freed with the isolate) and in each
+// context's embedder data (index 5). Threading: the isolate's thread, the isolate entered and locked by the caller, as
+// for every export here; nothing is shared between isolates but the counter the numbers come from.
+#include <atomic>
+#include <cstdint>
+#include <iterator>
+#include <memory>
+
+namespace Ssrs2Contexts
+{
+    constexpr uint32_t kIsolateSlot = 2;
+    constexpr int kNumberIndex = 5;
+
+    struct Table
+    {
+        std::unordered_map<int32_t, v8::Global<v8::Context>> contexts;
+        size_t sweepAt = 64;
+    };
+
+    static std::atomic<int32_t> g_next { 1 };
+
+    static Table* TableOf(v8::Isolate* isolate, bool make)
+    {
+        auto table = static_cast<Table*>(isolate->GetData(kIsolateSlot));
+        if (table == nullptr && make)
+        {
+            table = new Table();
+            isolate->SetData(kIsolateSlot, table);
+        }
+        return table;
+    }
+
+    // The number a context carries (0: none), which names it only while the isolate's table has it for that context
+    // (a context read from a snapshot carries what the snapshot's had).
+    static int32_t Stored(v8::Local<v8::Context> context)
+    {
+        if (context->GetNumberOfEmbedderDataFields() <= static_cast<uint32_t>(kNumberIndex))
+        {
+            return 0;
+        }
+        auto data = context->GetEmbedderDataV2(kNumberIndex);
+        if (data.IsEmpty() || !data->IsValue() || !data.As<v8::Value>()->IsInt32())
+        {
+            return 0;
+        }
+        return data.As<v8::Int32>()->Value();
+    }
+
+    // The context's number, given now where it has none; 0 when there is none left to give.
+    static int32_t NumberOf(v8::Isolate* isolate, v8::Local<v8::Context> context)
+    {
+        auto table = TableOf(isolate, true);
+        int32_t number = Stored(context);
+        if (number > 0)
+        {
+            auto found = table->contexts.find(number);
+            if (found != table->contexts.end() && found->second.Get(isolate) == context)
+            {
+                return number;
+            }
+        }
+        number = g_next.fetch_add(1);
+        if (number <= 0)
+        {
+            g_next.store(INT32_MIN);
+            return 0;
+        }
+        // (the references of collected contexts dropped, now and then)
+        if (table->contexts.size() >= table->sweepAt)
+        {
+            for (auto it = table->contexts.begin(); it != table->contexts.end(); )
+            {
+                it = it->second.IsEmpty() ? table->contexts.erase(it) : std::next(it);
+            }
+            table->sweepAt = table->contexts.size() * 2 + 64;
+        }
+        auto& slot = table->contexts[number];
+        slot.Reset(isolate, context);
+        slot.SetWeak();
+        context->SetEmbedderDataV2(kNumberIndex, v8::Integer::New(isolate, number));
+        return number;
+    }
+
+    // The context a number names (0: the current one): empty for a number that names none.
+    static v8::Local<v8::Context> Find(v8::Isolate* isolate, int32_t number)
+    {
+        if (number == 0)
+        {
+            return isolate->InContext() ? isolate->GetCurrentContext() : v8::Local<v8::Context>();
+        }
+        auto table = TableOf(isolate, false);
+        if (table == nullptr)
+        {
+            return v8::Local<v8::Context>();
+        }
+        auto found = table->contexts.find(number);
+        if (found == table->contexts.end())
+        {
+            return v8::Local<v8::Context>();
+        }
+        auto context = found->second.Get(isolate);
+        if (context.IsEmpty())
+        {
+            table->contexts.erase(found);
+        }
+        return context;
+    }
+}
+
+// (V8ContextImpl::Teardown: the context's number names nothing from here on)
+void Ssrs2ContextGone(v8::Isolate* isolate, v8::Local<v8::Context> context)
+{
+    auto table = Ssrs2Contexts::TableOf(isolate, false);
+    if (table == nullptr || context.IsEmpty())
+    {
+        return;
+    }
+    int32_t number = Ssrs2Contexts::Stored(context);
+    auto found = table->contexts.find(number);
+    if (number > 0 && found != table->contexts.end() && found->second.Get(isolate) == context)
+    {
+        table->contexts.erase(found);
+    }
+}
+
+// (V8IsolateImpl's destructor, the isolate still there: its table freed)
+void Ssrs2IsolateGone(v8::Isolate* isolate)
+{
+    delete Ssrs2Contexts::TableOf(isolate, false);
+    isolate->SetData(Ssrs2Contexts::kIsolateSlot, nullptr);
+}
+
+NATIVE_ENTRY_POINT(int32_t) Ssrs2_ContextNumber() noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr || !isolate->InContext())
+    {
+        return 0;
+    }
+    v8::HandleScope scope(isolate);
+    return Ssrs2Contexts::NumberOf(isolate, isolate->GetCurrentContext());
+}
