+// A context's check of code generation answered by the host (0032): where 0019's check is a script function, this one
+// is a C function of the host's.
+//
+//   typedef struct { const uint16_t* source; int32_t sourceLength; const uint16_t* message; int32_t messageLength; } Ssrs2CodeGenAnswer;
+//   typedef int32_t (*Ssrs2CodeGenHostCheck)(int32_t context, int32_t flags, const uint16_t* source, int32_t length, Ssrs2CodeGenAnswer* answer);
+//   int32_t Ssrs2_SetCodeGenHostCheck(int32_t context, Ssrs2CodeGenHostCheck check, const uint16_t* message, int32_t messageLength);
+//
+// Ssrs2_SetCodeGenHostCheck gives the context (its number, or 0 for the current one) the check, with the message of
+// the error a refusal throws where the check gives none (UTF-16; null: V8's own words), and answers the context's
+// number, 0 where there is no such context. check null takes the context's host check away (strings compile again
+// unchecked). The function is the process's: the last one given is the one called, for every context that has a host
+// check. A context has one check: a host check replaces 0019's script check and the reverse.
+//
+// V8 then asks the check, on the isolate's thread, from inside the script's request:
+//   - before it compiles a string (eval, the Function constructors' assembled source text): flags 0, source the text;
+//   - for a code-like object (0013) given to eval or to a Function constructor: flags 2, source the object's text;
+//   - for any other object given to eval or to a Function constructor: flags 4, no source (null, 0), the object left
+//     at index 1 of the context's handle table (0030) where it has one;
+//   - before it compiles WebAssembly from bytes (WebAssembly.Module, compile, instantiate, their streaming forms):
+//     flags 1, no source.
+// It answers 0 to refuse, 1 to allow what was given (an object of flags 4 is then left as it is: eval returns it, a
+// Function constructor converts it to a string), 2 to allow with the text it puts in answer->source compiled in place
+// of what was given (WebAssembly: as 1). On a refusal V8 throws an EvalError (WebAssembly: a CompileError, or rejects
+// the promise with one) whose message is answer->message where the check set it, else the message given here. A value
+// that is neither a string nor an object (eval(5)) is not code: the check is not asked. V8 may ask twice for one
+// request (an object given to a direct eval: once when it resolves the call, once as the global eval's argument).
+//
+// The callback's contract. source is the library's and dies when the check returns. What the check puts in the answer
+// stays the host's, valid until the check is next called on that thread (the library copies it as soon as the check
+// returns). The check may be entered again before it returns, if it runs script that asks for code itself (it may
+// call Ssrs2_Call and Ssrs2_CallIn: V8 allows script here, and the library keeps nothing of its own across the call);
+// it must leave no script exception pending, must not dispose the context, its engine or the isolate, and must not
+// wait for another thread that needs the isolate.
+// (the context's embedder data that holds its check: 0019's script function, or a host check's default message)
+static const int kSsrs2CodeGenCheckIndex = 3;
+
+namespace Ssrs2CodeGenHost
+{
+    enum : int32_t { kWasm = 1, kCodeLike = 2, kObject = 4 };
+
+    struct Answer
+    {
+        const uint16_t* source;
+        int32_t sourceLength;
+        const uint16_t* message;
+        int32_t messageLength;
+    };
+
+    using Check = int32_t (*)(int32_t context, int32_t flags, const uint16_t* source, int32_t length, Answer* answer);
+
+    static std::atomic<Check> g_check { nullptr };
+
+    // The host check's default message, where the context has a host check (its embedder data at 0019's index: a
+    // function for a script check, a string for a host check).
+    static bool DefaultMessage(v8::Local<v8::Context> context, v8::Local<v8::String>* message)
+    {
+        if (context->GetNumberOfEmbedderDataFields() <= static_cast<uint32_t>(kSsrs2CodeGenCheckIndex))
+        {
+            return false;
+        }
+        auto data = context->GetEmbedderDataV2(kSsrs2CodeGenCheckIndex);
+        if (data.IsEmpty() || !data->IsValue() || !data.As<v8::Value>()->IsString())
+        {
+            return false;
+        }
+        *message = data.As<v8::String>();
+        return true;
+    }
+
+    static v8::Local<v8::String> Message(v8::Isolate* isolate, const Answer& answer, v8::Local<v8::String> byDefault)
+    {
+        v8::Local<v8::String> message;
+        if (answer.message != nullptr && answer.messageLength >= 0
+            && v8::String::NewFromTwoByte(isolate, answer.message, v8::NewStringType::kNormal, answer.messageLength).ToLocal(&message))
+        {
+            return message;
+        }
+        return byDefault;
+    }
+
+    // V8's request for a string or an object, answered by the host.
+    static v8::ModifyCodeGenerationFromStringsResult Ask(v8::Isolate* isolate, v8::Local<v8::Context> context, v8::Local<v8::Value> source, bool isCodeLike, v8::Local<v8::String> byDefault)
+    {
+        v8::ModifyCodeGenerationFromStringsResult result;
+        result.codegen_allowed = false;
+        auto check = g_check.load();
+        if (check == nullptr)
+        {
+            return result;
+        }
+        int32_t flags = 0;
+        v8::Local<v8::String> text;
+        if (source->IsString())
+        {
+            text = source.As<v8::String>();
+        }
+        else if (!source->IsObject())
+        {
+            // (a number, a boolean, a symbol: no code is made of it)
+            result.codegen_allowed = true;
+            return result;
+        }
+        else if (isCodeLike)
+        {
+            flags = kCodeLike;
+            v8::TryCatch tryCatch(isolate);
+            if (!source->ToString(context).ToLocal(&text))
+            {
+                return result;
+            }
+        }
+        else
+        {
+            flags = kObject;
+            (void)Ssrs2HandlePut(context, 1, source);
+        }
+        // (a copy of the text for this call alone: the check may be entered again before it returns)
+        std::unique_ptr<uint16_t[]> chars;
+        int32_t length = 0;
+        if (!text.IsEmpty())
+        {
+            length = text->Length();
+            chars.reset(new uint16_t[static_cast<size_t>(length) + 1]);
+            text->WriteV2(isolate, 0, static_cast<uint32_t>(length), chars.get());
+            chars[length] = 0;
+        }
+        Answer answer { nullptr, 0, nullptr, 0 };
+        int32_t verdict = check(Ssrs2Contexts::NumberOf(isolate, context), flags, chars.get(), length, &answer);
+        if (verdict == 0)
+        {
+            context->SetErrorMessageForCodeGenerationFromStrings(Message(isolate, answer, byDefault));
+            return result;
+        }
+        result.codegen_allowed = true;
+        v8::Local<v8::String> replacement;
+        if (verdict == 2 && answer.source != nullptr && answer.sourceLength >= 0
+            && v8::String::NewFromTwoByte(isolate, answer.source, v8::NewStringType::kNormal, answer.sourceLength).ToLocal(&replacement))
+        {
+            result.modified_source = replacement;
+        }
+        else if (!text.IsEmpty())
+        {
+            result.modified_source = text;
+        }
+        return result;
+    }
+
+    // V8's request before it compiles WebAssembly from bytes (it gives no source): a context without a host check
+    // allows it, as V8 does without the callback.
+    static bool AskWasm(v8::Local<v8::Context> context, v8::Local<v8::String>)
+    {
+        auto isolate = v8::Isolate::GetCurrent();
+        v8::Local<v8::String> byDefault;
+        if (!DefaultMessage(context, &byDefault))
+        {
+            return true;
+        }
+        auto check = g_check.load();
+        if (check == nullptr)
+        {
+            return false;
+        }
+        Answer answer { nullptr, 0, nullptr, 0 };
+        if (check(Ssrs2Contexts::NumberOf(isolate, context), kWasm, nullptr, 0, &answer) != 0)
+        {
+            return true;
+        }
+        context->SetErrorMessageForWasmCodeGeneration(Message(isolate, answer, byDefault));
+        return false;
+    }
 }
 
