+// (0032: see Ssrs2CodeGenHost above)
+NATIVE_ENTRY_POINT(int32_t) Ssrs2_SetCodeGenHostCheck(int32_t context, void* check, const uint16_t* message, int32_t messageLength) noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr)
+    {
+        return 0;
+    }
+    v8::HandleScope scope(isolate);
+    auto target = Ssrs2Contexts::Find(isolate, context);
+    if (target.IsEmpty())
+    {
+        return 0;
+    }
+    if (check == nullptr)
+    {
+        v8::Local<v8::String> was;
+        if (Ssrs2CodeGenHost::DefaultMessage(target, &was))
+        {
+            target->SetEmbedderDataV2(kSsrs2CodeGenCheckIndex, v8::Undefined(isolate));
+            target->AllowCodeGenerationFromStrings(true);
+        }
+        return Ssrs2Contexts::NumberOf(isolate, target);
+    }
+    v8::Local<v8::String> byDefault;
+    if (message == nullptr || messageLength < 0
+        || !v8::String::NewFromTwoByte(isolate, message, v8::NewStringType::kNormal, messageLength).ToLocal(&byDefault))
+    {
+        byDefault = v8::String::NewFromUtf8Literal(isolate, "Code generation from strings disallowed for this context");
+    }
+    int32_t number = Ssrs2Contexts::NumberOf(isolate, target);
+    if (number == 0)
+    {
+        return 0;
+    }
+    Ssrs2CodeGenHost::g_check.store(reinterpret_cast<Ssrs2CodeGenHost::Check>(check));
+    isolate->SetModifyCodeGenerationFromStringsCallback(Ssrs2CodeGenCallback);
+    isolate->SetAllowWasmCodeGenerationCallback(Ssrs2CodeGenHost::AskWasm);
+    target->SetEmbedderDataV2(kSsrs2CodeGenCheckIndex, byDefault);
+    target->SetErrorMessageForCodeGenerationFromStrings(byDefault);
+    target->SetErrorMessageForWasmCodeGeneration(byDefault);
+    target->AllowCodeGenerationFromStrings(false);
+    return number;
 }
 
