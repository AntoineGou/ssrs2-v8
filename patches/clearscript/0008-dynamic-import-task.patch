diff --git a/ClearScriptV8/V8SplitProxyNative.cpp b/ClearScriptV8/V8SplitProxyNative.cpp
index d480bb0e..7eb82986 100644
--- a/ClearScriptV8/V8SplitProxyNative.cpp
+++ b/ClearScriptV8/V8SplitProxyNative.cpp
@@ -2525,9 +2525,69 @@ NATIVE_ENTRY_POINT(int) Ssrs2_InstallCreationContext(const char* holder, const c
 
 // (32-bit Windows decorates a __stdcall export's name, _Ssrs2_InstallDirectCalls@20: the plain names too, which a host
 // looking the functions up by name finds on every platform)
+// The context's import scheduler (V8ContextImpl::ImportModule): global[holder][name] made a function the script calls
+// with its scheduler, a function given each dynamic import's evaluation as a function to call a task later (as a
+// browser's fetch completes), kept on the context's global; without one the evaluation runs in a microtask. In a host call
+// only (the isolate entered, a context current); 0 otherwise.
+namespace Ssrs2ImportScheduler
+{
+    static void Install(const v8::FunctionCallbackInfo<v8::Value>& info)
+    {
+        auto isolate = info.GetIsolate();
+        auto context = isolate->GetCurrentContext();
+        auto key = v8::Private::ForApi(isolate, v8::String::NewFromUtf8Literal(isolate, "ssrs2.importScheduler"));
+        if (info.Length() >= 1 && info[0]->IsFunction())
+        {
+            (void)context->Global()->SetPrivate(context, key, info[0]);
+        }
+        else
+        {
+            (void)context->Global()->DeletePrivate(context, key);
+        }
+    }
+}
+
+NATIVE_ENTRY_POINT(int) Ssrs2_InstallImportScheduler(const char* holder, const char* name) noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr || !isolate->InContext() || holder == nullptr || name == nullptr)
+    {
+        return 0;
+    }
+    v8::HandleScope scope(isolate);
+    auto context = isolate->GetCurrentContext();
+    auto global = context->Global();
+    auto key = v8::String::NewFromUtf8(isolate, holder).ToLocalChecked();
+    v8::Local<v8::Value> existing;
+    v8::Local<v8::Object> object;
+    if (global->Get(context, key).ToLocal(&existing) && existing->IsObject())
+    {
+        object = existing.As<v8::Object>();
+    }
+    else
+    {
+        object = v8::Object::New(isolate);
+        if (global->Set(context, key, object).IsNothing())
+        {
+            return 0;
+        }
+    }
+    v8::Local<v8::Function> function;
+    if (!v8::Function::New(context, Ssrs2ImportScheduler::Install, v8::Local<v8::Value>(), 1, v8::ConstructorBehavior::kThrow).ToLocal(&function))
+    {
+        return 0;
+    }
+    if (object->Set(context, v8::String::NewFromUtf8(isolate, name).ToLocalChecked(), function).IsNothing())
+    {
+        return 0;
+    }
+    return 1;
+}
