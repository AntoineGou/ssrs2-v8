+// SSRS2: a dynamic import's module, had at the call, linked and evaluated later (V8ContextImpl::ImportModule).
+struct Ssrs2DeferredImport
+{
+    v8::Global<v8::Context> Context;
+    v8::Global<v8::Module> Module;
+    v8::Global<v8::Promise::Resolver> Resolver;
+    v8::Global<v8::Function> Runner;
+    bool Done = false;
+
+    // The context's import scheduler, a function of the host's (Ssrs2_InstallImportScheduler), kept on its global.
+    static v8::Local<v8::Private> SchedulerKey(v8::Isolate* pIsolate)
+    {
+        return v8::Private::ForApi(pIsolate, v8::String::NewFromUtf8Literal(pIsolate, "ssrs2.importScheduler"));
+    }
+
+    // The evaluation handed to the context's scheduler as a function it calls once: false where there is none.
+    static bool Schedule(v8::Isolate* pIsolate, v8::Local<v8::Context> hContext, Ssrs2DeferredImport* pDeferred, v8::Local<v8::Value> hName)
+    {
+        v8::Local<v8::Value> hScheduler;
+        if (!hContext->Global()->GetPrivate(hContext, SchedulerKey(pIsolate)).ToLocal(&hScheduler) || !hScheduler->IsFunction())
+        {
+            return false;
+        }
+        v8::Local<v8::Function> hRunner;
+        if (!v8::Function::New(hContext, [] (const v8::FunctionCallbackInfo<v8::Value>& info)
+            {
+                auto pDeferred = static_cast<Ssrs2DeferredImport*>(info.Data().As<v8::External>()->Value(v8::kExternalPointerTypeTagDefault));
+                if (pDeferred->Done) return;
+                pDeferred->Done = true;
+                pDeferred->Run(info.GetIsolate());
+            }, v8::External::New(pIsolate, pDeferred, v8::kExternalPointerTypeTagDefault), 0, v8::ConstructorBehavior::kThrow).ToLocal(&hRunner))
+        {
+            return false;
+        }
+        // (freed with the function: called or never)
+        pDeferred->Runner.Reset(pIsolate, hRunner);
+        pDeferred->Runner.SetWeak(pDeferred, [] (const v8::WeakCallbackInfo<Ssrs2DeferredImport>& info)
+        {
+            auto pDeferred = info.GetParameter();
+            pDeferred->Runner.Reset();
+            delete pDeferred;
+        }, v8::WeakCallbackType::kParameter);
+        v8::TryCatch tryCatch(pIsolate);
+        v8::Local<v8::Value> args[] = { hRunner, hName };
+        if (hScheduler.As<v8::Function>()->Call(hContext, v8::Undefined(pIsolate), 2, args).IsEmpty())
+        {
+            // (a scheduler that threw: the function called in a microtask, as without one, kept alive until then)
+            struct Hold { v8::Global<v8::Function> Runner; };
+            auto pHold = new Hold();
+            pHold->Runner.Reset(pIsolate, hRunner);
+            pIsolate->EnqueueMicrotask([] (void* pvData)
+            {
+                std::unique_ptr<Hold> upHold(static_cast<Hold*>(pvData));
+                auto pIsolate = v8::Isolate::GetCurrent();
+                v8::HandleScope handleScope(pIsolate);
+                auto hRunner = upHold->Runner.Get(pIsolate);
+                v8::Local<v8::Context> hContext;
+                if (!hRunner->GetCreationContext(pIsolate).ToLocal(&hContext)) return;
+                v8::Context::Scope contextScope(hContext);
+                (void)hRunner->Call(hContext, v8::Undefined(pIsolate), 0, nullptr);
+            }, pHold);
+        }
+        return true;
+    }
+
+    // The module linked and evaluated, the import's promise settled by its evaluation. A module whose evaluation threw,
+    // now or before, rejects the import with its error; one whose evaluation is a promise (top-level await) settles it
+    // when it settles. The evaluation's own promise is the import's business: handled, so that its rejection is no
+    // unhandled one of the page's (the import's promise is the page's to handle).
+    void Run(v8::Isolate* pIsolate)
+    {
+        v8::HandleScope handleScope(pIsolate);
+        auto hContext = Context.Get(pIsolate);
+        auto hModule = Module.Get(pIsolate);
+        auto hResolver = Resolver.Get(pIsolate);
+        if (hContext.IsEmpty() || hModule.IsEmpty() || hResolver.IsEmpty()) return;
+        v8::Context::Scope contextScope(hContext);
+        v8::TryCatch tryCatch(pIsolate);
+        v8::Local<v8::Value> hEvaluation;
+        bool ok = true;
+        if (hModule->GetStatus() == v8::Module::kUninstantiated)
+        {
+            ok = hModule->InstantiateModule(hContext, V8IsolateImpl::ModuleResolveCallback).FromMaybe(false);
+        }
+        if (ok && hModule->GetStatus() == v8::Module::kInstantiated)
+        {
+            ok = hModule->Evaluate(hContext).ToLocal(&hEvaluation);
+        }
+        if (!ok)
+        {
+            if (tryCatch.HasCaught()) (void)hResolver->Reject(hContext, tryCatch.Exception());
+            return;
+        }
+        if (!hEvaluation.IsEmpty() && hEvaluation->IsPromise())
+        {
+            auto hEvaluationPromise = hEvaluation.As<v8::Promise>();
+            // (its rejection reported as handled: a handler of nothing, V8 telling the embedder a handler came)
+            v8::Local<v8::Function> hNothing;
+            if (v8::Function::New(hContext, [] (const v8::FunctionCallbackInfo<v8::Value>&) { }).ToLocal(&hNothing))
+            {
+                (void)hEvaluationPromise->Catch(hContext, hNothing);
+            }
+            hEvaluationPromise->MarkAsHandled();
+        }
+        if (hModule->GetStatus() == v8::Module::kErrored)
+        {
+            (void)hResolver->Reject(hContext, hModule->GetException());
+            return;
+        }
+        if (!hEvaluation.IsEmpty() && hEvaluation->IsPromise())
+        {
+            auto hEvaluationPromise = hEvaluation.As<v8::Promise>();
+            if (hEvaluationPromise->State() == v8::Promise::kRejected)
+            {
+                (void)hResolver->Reject(hContext, hEvaluationPromise->Result());
+                return;
+            }
+            if (hEvaluationPromise->State() == v8::Promise::kPending)
+            {
+                v8::Local<v8::Function> hAnswer;
+                v8::Local<v8::Promise> hThen;
+                if (v8::Function::New(hContext, [] (const v8::FunctionCallbackInfo<v8::Value>& info) { info.GetReturnValue().Set(info.Data()); }, hModule->GetModuleNamespace()).ToLocal(&hAnswer)
+                    && hEvaluationPromise->Then(hContext, hAnswer).ToLocal(&hThen))
+                {
+                    (void)hResolver->Resolve(hContext, hThen);
+                }
+                else if (tryCatch.HasCaught())
+                {
+                    (void)hResolver->Reject(hContext, tryCatch.Exception());
+                }
+                return;
+            }
+        }
+        (void)hResolver->Resolve(hContext, hModule->GetModuleNamespace());
+    }
+};
