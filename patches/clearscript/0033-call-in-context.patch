+// A call into script with the context entered by the library (0033).
+//
+//   int Ssrs2_CallIn(int32_t context, int32_t function, int32_t receiver, const Value* args, int32_t count, int32_t flags, Value* result);
+//
+// Ssrs2_Call's call (0030: the function and the receiver by their handles, the arguments and the answer as a direct
+// call's), made in the context a number names (0032; 0: the current one, as Ssrs2_Call) whichever context is current,
+// or none: the library enters the context, calls the function and leaves. The handles are those of that context's
+// table; an object answered is left at its index 1 and what was thrown at its index 2. For a host that runs, from one
+// context's host call or from no script at all, a task that belongs to another context of the isolate. flags 1: a
+// microtask checkpoint of the isolate after the call, whether it returned or threw, before the answer is read (as
+// Ssrs2_PerformMicrotaskCheckpoint: also under other script frames, where V8 runs none by itself). Answers as
+// Ssrs2_Call: 1, 0, -1 (also: no isolate entered on this thread, or a number that names no context), -2.
+//
+// Threading: the isolate's thread, the isolate entered and locked by the caller (inside a host call, or inside the
+// lock the host's engine takes around its own work); the library takes no lock. Where no script of the isolate is
+// running, the call runs inside ClearScript's execution scope, as a script its engine runs does: the engine's
+// interrupt stops it (-2) and is over when the call returns. Under other script frames (a host call) an interrupt
+// stops those frames too, as it does for Ssrs2_Call. Re-entrancy: the function may call the host, which may call
+// Ssrs2_Call and Ssrs2_CallIn again, for this context or another; each call reads its answer after the calls it
+// contains. The answer's string is the thread's until the next call into script on it; the handles 1 and 2 are the
+// context's until its next call.
+NATIVE_ENTRY_POINT(int) Ssrs2_CallIn(int32_t context, int32_t function, int32_t receiver, const Ssrs2DirectCalls::Value* args, int32_t count, int32_t flags, Ssrs2DirectCalls::Value* result) noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr || result == nullptr || count < 0 || count > Ssrs2Calls::MaxArgs || (args == nullptr && count > 0))
+    {
+        return -1;
+    }
+    v8::HandleScope scope(isolate);
+    auto target = Ssrs2Contexts::Find(isolate, context);
+    if (target.IsEmpty())
+    {
+        return -1;
+    }
+    v8::Context::Scope contextScope(target);
+    auto isolateImpl = V8IsolateImpl::GetInstanceFromIsolate(isolate);
+    if (isolateImpl != nullptr && !isolateImpl->Ssrs2InExecutionScope())
+    {
+        V8IsolateImpl::ExecutionScope executionScope(*isolateImpl);
+        return Ssrs2Calls::Invoke(isolate, target, function, receiver, args, count, flags, result);
+    }
+    return Ssrs2Calls::Invoke(isolate, target, function, receiver, args, count, flags, result);
+}
