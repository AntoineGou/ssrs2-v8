+++ b/ClearScriptV8/V8ContextImpl.cpp
@@ -407,6 +407,9 @@ V8ContextImpl::V8ContextImpl(V8IsolateImpl* pIsolateImpl, const StdString& name)
 
 //-----------------------------------------------------------------------------
 
+// SSRS2 (0021): see V8ContextImpl.h.
+thread_local bool g_Ssrs2ImmutableGlobalPrototype = false;
+
 V8ContextImpl::V8ContextImpl(SharedPtr<V8IsolateImpl>&& spIsolateImpl, void* pvEngine, const StdString& name, const Options& options):
     m_Name(name),
     m_pvEngine(pvEngine),
@@ -433,7 +436,15 @@ V8ContextImpl::V8ContextImpl(SharedPtr<V8IsolateImpl>&& spIsolateImpl, void* pvE
     BEGIN_ISOLATE_SCOPE
     FROM_MAYBE_TRY
 
-        if (::HasFlag(options.Flags, Flags::DisableGlobalMembers))
+        // SSRS2 (0021): a global whose prototype cannot be changed, where the host asked it (WebIDL's [Global] objects:
+        // their [[SetPrototypeOf]] an immutable prototype exotic object's). Its prototype is the one V8 makes with it.
+        if (::HasFlag(options.Flags, Flags::DisableGlobalMembers) && g_Ssrs2ImmutableGlobalPrototype)
+        {
+            auto hGlobalTemplate = CreateObjectTemplate();
+            hGlobalTemplate->SetImmutableProto();
+            m_hContext = CreatePersistent(CreateContext(nullptr, hGlobalTemplate));
+        }
+        else if (::HasFlag(options.Flags, Flags::DisableGlobalMembers))
         {
             m_hContext = CreatePersistent(CreateContext());
         }
@@ -441,6 +452,10 @@ V8ContextImpl::V8ContextImpl(SharedPtr<V8IsolateImpl>&& spIsolateImpl, void* pvE
         {
             auto hGlobalTemplate = CreateObjectTemplate();
             hGlobalTemplate->SetInternalFieldCount(1);
+            if (g_Ssrs2ImmutableGlobalPrototype)
+            {
+                hGlobalTemplate->SetImmutableProto();
+            }
             hGlobalTemplate->SetHandler(v8::NamedPropertyHandlerConfiguration(GetGlobalProperty, SetGlobalProperty, QueryGlobalProperty, DeleteGlobalProperty, GetGlobalPropertyNames, v8::Local<v8::Value>(), v8::PropertyHandlerFlags::kNonMasking));
             hGlobalTemplate->SetHandler(v8::IndexedPropertyHandlerConfiguration(GetGlobalProperty, SetGlobalProperty, QueryGlobalProperty, DeleteGlobalProperty, GetGlobalPropertyIndices));
 
diff --git a/ClearScriptV8/V8ContextImpl.h b/ClearScriptV8/V8ContextImpl.h
index f59251f..5d067eb 100644
--- a/ClearScriptV8/V8ContextImpl.h
+++ b/ClearScriptV8/V8ContextImpl.h
@@ -9,6 +9,10 @@
 
 class V8WeakContextBinding;
 
+// SSRS2 (0021): the contexts this thread makes while it is set have a global object with an immutable prototype
+// (Ssrs2_SetImmutableGlobalPrototype).
+extern thread_local bool g_Ssrs2ImmutableGlobalPrototype;
+
 //-----------------------------------------------------------------------------
 // V8ContextImpl
