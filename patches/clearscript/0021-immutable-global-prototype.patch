diff --git a/ClearScriptV8/V8SplitProxyNative.cpp b/ClearScriptV8/V8SplitProxyNative.cpp
index 1200260..e8b239e 100644
--- a/ClearScriptV8/V8SplitProxyNative.cpp
+++ b/ClearScriptV8/V8SplitProxyNative.cpp
@@ -3057,6 +3057,18 @@ NATIVE_ENTRY_POINT(int) Ssrs2_InstallEntryContext(const char* holder, const char
     return object->Set(context, v8::String::NewFromUtf8(isolate, name).ToLocalChecked(), function).IsJust() ? 1 : 0;
 }
 
+// The global's prototype immutable (0021): Ssrs2_SetImmutableGlobalPrototype(1) makes the contexts this thread creates
+// next have a global object whose prototype cannot be changed (v8::ObjectTemplate::SetImmutableProto on the global's
+// template: Object.setPrototypeOf throws a TypeError, Reflect.setPrototypeOf answers false, setting it to the prototype
+// it has excepted), (0) ordinary ones again. WebIDL's [Global] objects are immutable prototype exotic objects (§3.7.1);
+// the global's prototype is the object V8 makes with it, which a host takes as its global's interface prototype
+// (Window.prototype) rather than setting another. 1 (the library has it).
+NATIVE_ENTRY_POINT(int) Ssrs2_SetImmutableGlobalPrototype(int on) noexcept
+{
+    g_Ssrs2ImmutableGlobalPrototype = on != 0;
+    return 1;
+}
