 #if defined(_M_IX86)
 #pragma comment(linker, "/EXPORT:Ssrs2_InstallDirectCalls=_Ssrs2_InstallDirectCalls@20")
 #pragma comment(linker, "/EXPORT:Ssrs2_InstallFastCalls=_Ssrs2_InstallFastCalls@24")
@@ -3071,4 +3083,5 @@ NATIVE_ENTRY_POINT(int) Ssrs2_InstallEntryContext(const char* holder, const char
 #pragma comment(linker, "/EXPORT:Ssrs2_WasmMemoryLimit=_Ssrs2_WasmMemoryLimit@0")
 #pragma comment(linker, "/EXPORT:Ssrs2_InstallCodeGenCheck=_Ssrs2_InstallCodeGenCheck@8")
 #pragma comment(linker, "/EXPORT:Ssrs2_InstallEntryContext=_Ssrs2_InstallEntryContext@8")
+#pragma comment(linker, "/EXPORT:Ssrs2_SetImmutableGlobalPrototype=_Ssrs2_SetImmutableGlobalPrototype@4")
 #endif
