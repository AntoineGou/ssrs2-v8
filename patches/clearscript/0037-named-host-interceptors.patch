+                given->kind = Ssrs2DirectCalls::Boolean;
+                given->number = value->BooleanValue(isolate) ? 1 : 0;
+            }
+            else if (value->IsNull())
+            {
+                given->kind = Ssrs2DirectCalls::Null;
+            }
+            else if (value->IsString())
+            {
+                given->kind = Ssrs2DirectCalls::String;
+                given->data = chars.Of(isolate, value.As<v8::String>(), &given->length);
+            }
