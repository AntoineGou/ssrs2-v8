+
+    // ---- objects ----
+
+    static void Collected(const v8::WeakCallbackInfo<Recorder>& info)
+    {
+        auto r = info.GetParameter();
+        r->LetGo();
+        if (r->owner != nullptr) r->owner->live.erase(r);
+        Release(r);
+    }
+
+    static Isolates* IsolatesOf(v8::Isolate* isolate, bool make)
+    {
+        auto all = static_cast<Isolates*>(isolate->GetData(kIsolateSlot));
+        if (all == nullptr && make)
+        {
+            all = new Isolates();
+            isolate->SetData(kIsolateSlot, all);
+        }
+        return all;
+    }
+
+    // recordedObject(name, prototype, number): a new object of the kind named, of that prototype, with its recorder; the
+    // host told (made); undefined for a name the plan has no kind for or a prototype that is no object.
+    static void MakeObject(const v8::FunctionCallbackInfo<v8::Value>& info)
+    {
+        auto isolate = info.GetIsolate();
+        auto templates = static_cast<PlanTemplates*>(info.Data().As<v8::External>()->Value(v8::kExternalPointerTypeTagDefault));
+        auto plan = templates->plan;
+        if (info.Length() < 3 || !info[0]->IsString() || !info[1]->IsObject()) return;
+        v8::String::Utf8Value name(isolate, info[0]);
+        int32_t k = -1;
+        for (size_t i = 0; i < plan->kinds.size(); i++) if (*name != nullptr && plan->kinds[i].name == *name) k = static_cast<int32_t>(i);
+        if (k < 0) return;
+        auto context = isolate->GetCurrentContext();
+        auto& kind = templates->kinds[static_cast<size_t>(k)];
+        if (kind.type.IsEmpty()) return;
+        v8::Local<v8::Object> object;
+        if (!kind.type.Get(isolate)->InstanceTemplate()->NewInstance(context).ToLocal(&object)) return;
+        if (object->SetPrototype(context, info[1]).IsNothing()) return;
+        auto r = new Recorder();
+        auto& s = r->shared;
+        s.slots = plan->slots;
+        s.kind = k;
+        s.dirty = 1;
+        if (!Reserve(s, 0)) { delete r; return; }
+        std::memcpy(s.levels, plan->defaults.data(), sizeof(double) * static_cast<size_t>(plan->slots));
+        uint64_t address = reinterpret_cast<uintptr_t>(r);
+        object->SetInternalField(kMarkField, v8::Integer::New(isolate, kMark));
+        object->SetInternalField(kLowField, v8::Integer::New(isolate, static_cast<int32_t>(static_cast<uint32_t>(address & kHalfMask))));
+        object->SetInternalField(kHighField, v8::Integer::New(isolate, static_cast<int32_t>(static_cast<uint32_t>(address >> kHalfBits))));
+        r->owner = IsolatesOf(isolate, true);
+        r->owner->live.insert(r);
+        r->self.Reset(isolate, object);
+        r->self.SetWeak(r, Collected, v8::WeakCallbackType::kParameter);
+        auto made = g_made.load();
+        int32_t number = info[2]->IsInt32() ? info[2].As<v8::Int32>()->Value() : 0;
+        if (made != nullptr) s.tag = made(Ssrs2Contexts::NumberOf(isolate, context), number, k, &s);
+        info.GetReturnValue().Set(object);
+    }
+
+    // (the isolate going: each recorder's object let go, the host's references kept until it releases them)
+    static void IsolateGone(v8::Isolate* isolate)
+    {
+        auto all = IsolatesOf(isolate, false);
+        if (all == nullptr) return;
+        for (auto r : all->live)
+        {
+            r->LetGo();
+            r->owner = nullptr;
+            Release(r);
+        }
+        all->live.clear();
+        for (auto& plan : all->plans)
+        {
+            plan->maker.Reset();
+            for (auto& kind : plan->kinds)
+            {
+                kind.type.Reset();
+                for (auto& t : kind.operations) t.Reset();
+                for (auto& t : kind.getters) t.Reset();
+                for (auto& t : kind.setters) t.Reset();
+            }
+        }
+        delete all;
+        isolate->SetData(kIsolateSlot, nullptr);
+    }
+
+    static v8::Local<v8::FunctionTemplate> MemberTemplate(v8::Isolate* isolate, KindTemplates& kind, v8::Global<v8::FunctionTemplate>& slot, const MemberRef& ref,
+        const std::string& name, int length, const v8::CFunction* fast)
+    {
+        if (!slot.IsEmpty()) return slot.Get(isolate);
+        if (ref.at < 0) return v8::Local<v8::FunctionTemplate>();
+        auto t = v8::FunctionTemplate::New(isolate, CallbackOf(ref.at), v8::Integer::New(isolate, ref.at),
+            v8::Signature::New(isolate, kind.type.Get(isolate)), length, v8::ConstructorBehavior::kThrow, v8::SideEffectType::kHasSideEffect, fast);
+        t->SetClassName(v8::String::NewFromUtf8(isolate, name.c_str()).ToLocalChecked());
+        slot.Reset(isolate, t);
+        return t;
+    }
+
+    static int Length(v8::Local<v8::Context> context, v8::Local<v8::Value> function)
+    {
+        v8::Local<v8::Value> length;
+        if (!function->IsFunction() || !function.As<v8::Object>()->Get(context, v8::String::NewFromUtf8Literal(v8::Isolate::GetCurrent(), "length")).ToLocal(&length) || !length->IsInt32()) return 0;
+        return length.As<v8::Int32>()->Value();
+    }
+
+    static bool Flag(v8::Local<v8::Context> context, v8::Local<v8::Object> descriptor, const char* name)
+    {
+        v8::Local<v8::Value> v;
+        return descriptor->Get(context, v8::String::NewFromUtf8(v8::Isolate::GetCurrent(), name).ToLocalChecked()).ToLocal(&v) && v->BooleanValue(v8::Isolate::GetCurrent());
+    }
+
+    static v8::Local<v8::Value> Field(v8::Local<v8::Context> context, v8::Local<v8::Object> descriptor, const char* name)
+    {
+        v8::Local<v8::Value> v;
+        if (!descriptor->Get(context, v8::String::NewFromUtf8(v8::Isolate::GetCurrent(), name).ToLocalChecked()).ToLocal(&v)) return v8::Undefined(v8::Isolate::GetCurrent());
+        return v;
+    }
+
+    // (a kind's members on its prototype: each one the prototype has now as its own replaced, its function kept as its
+    // delegate; none added that it has not)
+    static bool InstallKind(v8::Isolate* isolate, v8::Local<v8::Context> context, Plan& plan, Kind& kind, KindTemplates& kt, v8::Local<v8::Array> delegates)
+    {
+        if (kt.type.IsEmpty())
+        {
+            auto t = v8::FunctionTemplate::New(isolate);
+            t->SetClassName(v8::String::NewFromUtf8(isolate, kind.name.c_str()).ToLocalChecked());
+            t->InstanceTemplate()->SetInternalFieldCount(kFields);
+            kt.type.Reset(isolate, t);
+            kt.operations.resize(kind.operations.size());
+            kt.getters.resize(kind.accessors.size());
+            kt.setters.resize(kind.accessors.size());
+        }
+        v8::Local<v8::Value> constructor, prototypeValue;
+        if (!context->Global()->Get(context, v8::String::NewFromUtf8(isolate, kind.name.c_str()).ToLocalChecked()).ToLocal(&constructor) || !constructor->IsFunction()) return false;
+        if (!constructor.As<v8::Object>()->Get(context, v8::String::NewFromUtf8Literal(isolate, "prototype")).ToLocal(&prototypeValue) || !prototypeValue->IsObject()) return false;
+        auto prototype = prototypeValue.As<v8::Object>();
+        for (size_t i = 0; i < kind.operations.size(); i++)
+        {
+            auto& op = kind.operations[i];
+            auto key = v8::String::NewFromUtf8(isolate, op.name.c_str()).ToLocalChecked();
+            v8::Local<v8::Value> d;
+            if (!prototype->GetOwnPropertyDescriptor(context, key).ToLocal(&d) || !d->IsObject()) continue;
+            auto descriptor = d.As<v8::Object>();
+            auto existing = Field(context, descriptor, "value");
+            if (!existing->IsFunction()) continue;
+            auto t = MemberTemplate(isolate, kt, kt.operations[i], kind.operationRefs[i], op.name, Length(context, existing), op.fast ? FastOf(op.args.size()) : nullptr);
+            v8::Local<v8::Function> function;
+            if (t.IsEmpty() || !t->GetFunction(context).ToLocal(&function)) return false;
+            v8::PropertyDescriptor replaced(function, Flag(context, descriptor, "writable"));
+            replaced.set_enumerable(Flag(context, descriptor, "enumerable"));
+            replaced.set_configurable(Flag(context, descriptor, "configurable"));
+            if (delegates->Set(context, static_cast<uint32_t>(op.member), existing).IsNothing()) return false;
+            if (prototype->DefineProperty(context, key, replaced).IsNothing()) return false;
+        }
+        for (size_t i = 0; i < kind.accessors.size(); i++)
+        {
+            auto& ac = kind.accessors[i];
+            auto key = v8::String::NewFromUtf8(isolate, ac.name.c_str()).ToLocalChecked();
+            v8::Local<v8::Value> d;
+            if (!prototype->GetOwnPropertyDescriptor(context, key).ToLocal(&d) || !d->IsObject()) continue;
+            auto descriptor = d.As<v8::Object>();
+            auto get = Field(context, descriptor, "get"), set = Field(context, descriptor, "set");
+            if (!get->IsFunction() || (ac.setKind != 0 && !set->IsFunction())) continue;
+            v8::Local<v8::Value> newGet = get, newSet = set;
+            if (ac.getSlot >= 0)
+            {
+                v8::Local<v8::Function> f;
+                auto mt = MemberTemplate(isolate, kt, kt.getters[i], kind.getterRefs[i], "get " + ac.name, 0, nullptr);
+                if (mt.IsEmpty() || !mt->GetFunction(context).ToLocal(&f)) return false;
+                newGet = f;
+            }
+            if (ac.setKind != 0)
+            {
+                v8::Local<v8::Function> f;
+                auto mt = MemberTemplate(isolate, kt, kt.setters[i], kind.setterRefs[i], "set " + ac.name, 1, nullptr);
+                if (mt.IsEmpty() || !mt->GetFunction(context).ToLocal(&f)) return false;
+                newSet = f;
+            }
+            v8::PropertyDescriptor replaced(newGet, newSet);
+            replaced.set_enumerable(Flag(context, descriptor, "enumerable"));
+            replaced.set_configurable(Flag(context, descriptor, "configurable"));
+            if (delegates->Set(context, static_cast<uint32_t>(ac.member), get).IsNothing() || delegates->Set(context, static_cast<uint32_t>(ac.member + 1), set).IsNothing()) return false;
+            if (prototype->DefineProperty(context, key, replaced).IsNothing()) return false;
+        }
+        return true;
+    }
+}
