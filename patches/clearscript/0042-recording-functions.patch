+// (V8IsolateImpl's destructor through Ssrs2IsolateGone: the recording's per-isolate data freed)
+static void Ssrs2RecordingIsolateGone(v8::Isolate* isolate) { Ssrs2Recording::IsolateGone(isolate); }
