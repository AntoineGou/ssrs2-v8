+NATIVE_ENTRY_POINT(int) Ssrs2_InstallRecording(const char* holder, const double* plan, int32_t planLength, const char* names, int32_t namesLength, void* made, void* sync, void* answer) noexcept
+{
+    using namespace Ssrs2Recording;
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr || !isolate->InContext() || holder == nullptr || plan == nullptr || planLength <= 0 || names == nullptr || namesLength < 0) return 0;
+    v8::HandleScope scope(isolate);
+    auto context = isolate->GetCurrentContext();
+    auto all = IsolatesOf(isolate, true);
+    Plan* found = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(g_plansMutex);
+        for (auto& p : g_plans)
+        {
+            if (p->raw.size() == static_cast<size_t>(planLength) && std::memcmp(p->raw.data(), plan, sizeof(double) * static_cast<size_t>(planLength)) == 0
+                && p->names.size() == static_cast<size_t>(namesLength) && std::memcmp(p->names.data(), names, static_cast<size_t>(namesLength)) == 0)
+            {
+                found = p.get();
+            }
+        }
+        if (found == nullptr)
+        {
+            auto parsed = Parse(plan, planLength, names, namesLength);
+            if (parsed == nullptr) return 0;
+            found = parsed.get();
+            g_plans.push_back(std::move(parsed));
+        }
+    }
+    PlanTemplates* templates = nullptr;
+    for (auto& t : all->plans) if (t->plan == found) templates = t.get();
+    if (templates == nullptr)
+    {
+        all->plans.push_back(std::make_unique<PlanTemplates>());
+        templates = all->plans.back().get();
+        templates->plan = found;
+        templates->kinds.resize(found->kinds.size());
+    }
+    if (all->heapNumberMap == 0)
+    {
+        // (a heap number read in place where its map and value are where V8's own layout says: else through the API)
+        using I = v8::internal::Internals;
+        const double probe = 0.1234567;
+        auto number = v8::Number::New(isolate, probe);
+        auto a = v8::internal::ValueHelper::ValueAsAddress(*number);
+        if (I::HasHeapObjectTag(a) && I::ReadRawField<double>(a, I::kHeapObjectMapOffset + static_cast<int>(sizeof(v8::internal::Address))) == probe)
+            all->heapNumberMap = I::ReadRawField<v8::internal::Address>(a, I::kHeapObjectMapOffset);
+    }
+    g_made.store(reinterpret_cast<Made>(made));
+    g_sync.store(reinterpret_cast<Sync>(sync));
+    g_answer.store(reinterpret_cast<Answer>(answer));
+    auto delegates = v8::Array::New(isolate, found->members);
+    auto kinds = v8::Object::New(isolate, v8::Null(isolate), nullptr, nullptr, 0);
+    for (size_t k = 0; k < found->kinds.size(); k++)
+    {
+        auto& kind = found->kinds[k];
+        if (InstallKind(isolate, context, *found, kind, templates->kinds[k], delegates)
+            && kinds->Set(context, v8::String::NewFromUtf8(isolate, kind.name.c_str()).ToLocalChecked(), v8::True(isolate)).IsNothing()) return 0;
+    }
+    context->SetEmbedderDataV2(kDelegatesIndex, delegates);
+    auto object = Ssrs2Holder(isolate, context, holder);
+    if (object.IsEmpty()) return 0;
+    if (templates->maker.IsEmpty())
+    {
+        templates->maker.Reset(isolate, v8::FunctionTemplate::New(isolate, MakeObject, v8::External::New(isolate, templates, v8::kExternalPointerTypeTagDefault),
+            v8::Local<v8::Signature>(), 3, v8::ConstructorBehavior::kThrow));
+    }
+    v8::Local<v8::Function> maker;
+    if (!templates->maker.Get(isolate)->GetFunction(context).ToLocal(&maker)) return 0;
+    if (object->Set(context, v8::String::NewFromUtf8Literal(isolate, "recordedObject"), maker).IsNothing()
+        || object->Set(context, v8::String::NewFromUtf8Literal(isolate, "recordedNames"), kinds).IsNothing()) return 0;
+    return 1;
+}
+
+NATIVE_ENTRY_POINT(int) Ssrs2_RecordingRetain(void* recorder) noexcept
+{
+    if (recorder == nullptr) return 0;
+    reinterpret_cast<Ssrs2Recording::Recorder*>(recorder)->refs.fetch_add(1);
+    return 1;
+}
+
+NATIVE_ENTRY_POINT(int) Ssrs2_RecordingRelease(void* recorder) noexcept
+{
+    if (recorder == nullptr) return 0;
+    Ssrs2Recording::Release(reinterpret_cast<Ssrs2Recording::Recorder*>(recorder));
+    return 1;
+}
+
+// (the buffer's memory given back where nothing is in it: the host took a large recording and keeps its own copy)
+NATIVE_ENTRY_POINT(int) Ssrs2_RecordingTrim(void* recorder) noexcept
+{
+    if (recorder == nullptr) return 0;
+    auto& s = reinterpret_cast<Ssrs2Recording::Recorder*>(recorder)->shared;
+    if (s.count != 0) return 0;
+    std::free(s.ops);
+    s.ops = nullptr;
+    s.capacity = 0;
+    return 1;
+}
+
+NATIVE_ENTRY_POINT(int) Ssrs2_RecordingReserve(void* recorder, int32_t depth) noexcept
+{
+    if (recorder == nullptr) return 0;
+    return Ssrs2Recording::Reserve(reinterpret_cast<Ssrs2Recording::Recorder*>(recorder)->shared, depth) ? 1 : 0;
+}
