--- a/ClearScriptV8/V8ContextImpl.h
+++ b/ClearScriptV8/V8ContextImpl.h
@@ -19,6 +19,16 @@ class V8ContextImpl final: public V8Context
 
 public:
 
+    // SSRS2 (0017): what the context's host callbacks are given as their data. A context's functions and host objects
+    // outlive its teardown when its script still runs: a task V8 posted for the isolate (an asynchronous WebAssembly
+    // compile's result, its promise's reactions) after the engine was disposed called a host function, whose data was the
+    // freed context (a crash on a freed mutex, WPT's wasm folder at 6 jobs). The link is emptied at teardown, and freed
+    // when V8 collects the data that holds it (a weak handle): a callback then finds no context, as with no data.
+    struct Ssrs2Link final
+    {
+        V8ContextImpl* pContextImpl;
+    };
+
     V8ContextImpl(V8IsolateImpl* pIsolateImpl, const StdString& name);
     V8ContextImpl(SharedPtr<V8IsolateImpl>&& spIsolateImpl, void* pvEngine, const StdString& name, const Options& options);
     static size_t GetInstanceCount();
