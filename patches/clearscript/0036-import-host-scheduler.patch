+
+// A context's import scheduler answered by the host (0036): where 0008's scheduler is a script function, this one is
+// a C function of the host's.
+//
+//   typedef int32_t (*Ssrs2ImportHostScheduler)(int32_t context, int32_t continuation, const uint16_t* name, int32_t nameLength);
+//   int32_t Ssrs2_SetImportHostScheduler(int32_t context, Ssrs2ImportHostScheduler scheduler);
+//
+// Ssrs2_SetImportHostScheduler gives the context (its number, 0032, or 0 for the current one) the scheduler and
+// answers the context's number, 0 where there is no such context; scheduler null takes the context's host scheduler
+// away. The function is the process's: the last one given is the one called, for every context that has a host
+// scheduler. A context has one scheduler: the host's replaces 0008's script function and the reverse.
+//
+// When a script of the context calls import() for a module not evaluated yet, the library has the module (resolved,
+// loaded, compiled) and, in place of evaluating it in a microtask, calls the scheduler on the isolate's thread, from
+// inside the import() call, with: the context's number; the continuation, a handle of the context's table (0030):
+// always 1, the place of a call's answer, where the library left a function of no arguments that links and evaluates
+// the module and settles the import's promise; the module's resource name as the engine's document loader gave it
+// (UTF-16, the library's until the scheduler returns; null, 0 where it has none). The scheduler answers 1 when it took
+// the continuation: it then calls it once, later (a task later, as a fetch completes), with Ssrs2_Call or
+// Ssrs2_CallIn; called again it does nothing; never called, the import's promise never settles. It answers 0 to
+// decline: the module is evaluated in a microtask, as with no scheduler, which is also what happens in a context
+// without a handle table and for a module evaluated already.
+//
+// The callback's contract. Handle 1 names the continuation only until the next call into script of that context: a
+// scheduler that takes it moves it under a handle of its own before it returns (a script function of the host's,
+// called with handle 1 as its argument through Ssrs2_Call, which is allowed here), or keeps it some other way. It
+// must leave no script exception pending, must not call the continuation before it returns (the import() call is
+// still running), must not dispose the context, its engine or the isolate, and must not wait for another thread
+// that needs the isolate. It may be entered again if the script it runs imports a module itself.
+namespace Ssrs2ImportHost
+{
+    using Scheduler = int32_t (*)(int32_t context, int32_t continuation, const uint16_t* name, int32_t nameLength);
+
+    static std::atomic<Scheduler> g_scheduler { nullptr };
+}
+
+// (V8ContextImpl.cpp, Ssrs2DeferredImport::Schedule: the function that runs the evaluation handed to the host)
+bool Ssrs2ImportHostSchedule(v8::Isolate* isolate, v8::Local<v8::Context> context, v8::Local<v8::Function> runner, v8::Local<v8::Value> name)
+{
+    auto scheduler = Ssrs2ImportHost::g_scheduler.load();
+    if (scheduler == nullptr || !Ssrs2HandlePut(context, 1, runner))
+    {
+        return false;
+    }
+    // (a copy of the name for this call alone: the scheduler may be entered again before it returns)
+    std::unique_ptr<uint16_t[]> chars;
+    int32_t length = 0;
+    if (!name.IsEmpty() && name->IsString())
+    {
+        auto text = name.As<v8::String>();
+        length = text->Length();
+        chars.reset(new uint16_t[static_cast<size_t>(length) + 1]);
+        text->WriteV2(isolate, 0, static_cast<uint32_t>(length), chars.get());
+        chars[length] = 0;
+    }
+    return scheduler(Ssrs2Contexts::NumberOf(isolate, context), 1, chars.get(), length) != 0;
 }
 
+NATIVE_ENTRY_POINT(int32_t) Ssrs2_SetImportHostScheduler(int32_t context, void* scheduler) noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr)
+    {
+        return 0;
+    }
+    v8::HandleScope scope(isolate);
+    auto target = Ssrs2Contexts::Find(isolate, context);
+    if (target.IsEmpty())
+    {
+        return 0;
+    }
+    // (0008's key: a function there is a script's scheduler, true the host's)
+    auto key = v8::Private::ForApi(isolate, v8::String::NewFromUtf8Literal(isolate, "ssrs2.importScheduler"));
+    auto global = target->Global();
+    if (scheduler == nullptr)
+    {
+        v8::Local<v8::Value> was;
+        if (global->GetPrivate(target, key).ToLocal(&was) && was->IsTrue())
+        {
+            (void)global->DeletePrivate(target, key);
+        }
+        return Ssrs2Contexts::NumberOf(isolate, target);
+    }
+    int32_t number = Ssrs2Contexts::NumberOf(isolate, target);
+    if (number == 0 || !global->SetPrivate(target, key, v8::True(isolate)).FromMaybe(false))
+    {
+        return 0;
+    }
+    Ssrs2ImportHost::g_scheduler.store(reinterpret_cast<Ssrs2ImportHost::Scheduler>(scheduler));
+    return number;
+}
