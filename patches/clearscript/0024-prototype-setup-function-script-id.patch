+// Prototype setup (0024, with V8's 0006, v8::ssrs2::SetPrototypeSetupMode and OptimizePrototype): prototypeSetup(true) has
+// V8 leave the prototypes whose properties change in dictionary mode on this thread, rather than make each fast again
+// after each change once inline caches used it (linear in its properties each time: WebIDL's shapes applied to a
+// host's classes, every member of a used prototype redefined, took n * n); prototypeSetup(false, objects) ends that and
+// makes each object of the array fast again once, answering how many are. Only how fast properties are found changes.
+// globalThis[holder][name] made prototypeSetup, from inside a host call: 1 when made, 0 outside a context.
+static void Ssrs2PrototypeSetup(const v8::FunctionCallbackInfo<v8::Value>& info)
+{
+    auto isolate = info.GetIsolate();
+    bool on = info.Length() > 0 && info[0]->BooleanValue(isolate);
+    v8::ssrs2::SetPrototypeSetupMode(on);
+    if (on)
+    {
+        info.GetReturnValue().Set(0);
+        return;
+    }
+    int made = 0;
+    if (info.Length() > 1 && info[1]->IsArray())
+    {
+        auto context = isolate->GetCurrentContext();
+        auto objects = info[1].As<v8::Array>();
+        uint32_t length = objects->Length();
+        for (uint32_t i = 0; i < length; i++)
+        {
+            v8::Local<v8::Value> value;
+            if (objects->Get(context, i).ToLocal(&value) && value->IsObject() && !value->IsProxy() && v8::ssrs2::OptimizePrototype(value.As<v8::Object>()))
+            {
+                made++;
+            }
+        }
+    }
+    info.GetReturnValue().Set(made);
+}
+
+NATIVE_ENTRY_POINT(int) Ssrs2_InstallPrototypeSetup(const char* holder, const char* name) noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr || !isolate->InContext() || holder == nullptr || name == nullptr)
+    {
+        return 0;
+    }
+    v8::HandleScope scope(isolate);
+    auto context = isolate->GetCurrentContext();
+    auto object = Ssrs2Holder(isolate, context, holder);
+    v8::Local<v8::Function> function;
+    if (object.IsEmpty() || !v8::Function::New(context, Ssrs2PrototypeSetup, v8::Local<v8::Value>(), 2, v8::ConstructorBehavior::kThrow).ToLocal(&function))
+    {
+        return 0;
+    }
+    return object->Set(context, v8::String::NewFromUtf8(isolate, name).ToLocalChecked(), function).IsJust() ? 1 : 0;
+}
+
+// Function script ids (0024): functionScriptId(f) answers the id of the script f's code was compiled from (V8's
+// Function::ScriptId), -1 for a value that is no function or a function of no script (a bound function, a host's):
+// Function.prototype.toString prints the host's own functions as built-ins ("function f() { [native code] }") by the
+// script they come from, without keeping a set of them. globalThis[holder][name] made functionScriptId, from inside a
+// host call: 1 when made, 0 outside a context.
+static void Ssrs2FunctionScriptId(const v8::FunctionCallbackInfo<v8::Value>& info)
+{
+    int id = -1;
+    if (info.Length() > 0 && info[0]->IsFunction())
+    {
+        id = info[0].As<v8::Function>()->ScriptId();
+        if (id == v8::UnboundScript::kNoScriptId)
+        {
+            id = -1;
+        }
+    }
+    info.GetReturnValue().Set(id);
+}
+
+NATIVE_ENTRY_POINT(int) Ssrs2_InstallFunctionScriptId(const char* holder, const char* name) noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr || !isolate->InContext() || holder == nullptr || name == nullptr)
+    {
+        return 0;
+    }
+    v8::HandleScope scope(isolate);
+    auto context = isolate->GetCurrentContext();
+    auto object = Ssrs2Holder(isolate, context, holder);
+    v8::Local<v8::Function> function;
+    if (object.IsEmpty() || !v8::Function::New(context, Ssrs2FunctionScriptId, v8::Local<v8::Value>(), 1, v8::ConstructorBehavior::kThrow).ToLocal(&function))
+    {
+        return 0;
+    }
+    return object->Set(context, v8::String::NewFromUtf8(isolate, name).ToLocalChecked(), function).IsJust() ? 1 : 0;
+}
