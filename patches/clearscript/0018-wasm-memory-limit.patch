+//-----------------------------------------------------------------------------
+
+void V8IsolateImpl::Ssrs2GCEpilogue(v8::Isolate* pIsolate, v8::GCType /*type*/, v8::GCCallbackFlags /*flags*/, void* pvData)
+{
+    // SSRS2 (0018): the soft limit checked after each collection too, on the execution thread: memory outside the heap
+    // (a WebAssembly memory) makes V8 collect as it grows, while the heap watch timer, run through the host's thread
+    // pool, may wait (0011). Past the limit, the isolate is out of memory and its execution terminated, as the timer's
+    // check does under the termination policy. Cheap when nothing large is outside the heap: the external total first.
+    auto pIsolateImpl = static_cast<V8IsolateImpl*>(pvData);
+    auto maxHeapSize = pIsolateImpl->m_MaxHeapSize.load();
+    if ((maxHeapSize == 0) || pIsolateImpl->m_DisableHeapSizeViolationInterrupt || pIsolateImpl->m_IsOutOfMemory)
+    {
+        return;
+    }
+
+    auto external = v8::ExternalMemoryAccounter::GetTotalAmountOfExternalAllocatedMemoryForTesting(pIsolate);
+    if ((external <= 0) || (static_cast<size_t>(external) < maxHeapSize / 4))
+    {
+        return;
+    }
+
+    v8::HeapStatistics heapStatistics;
+    pIsolate->GetHeapStatistics(&heapStatistics);
+    if (pIsolateImpl->Ssrs2CountedSize(heapStatistics) > maxHeapSize)
+    {
+        pIsolateImpl->m_IsOutOfMemory = true;
+        pIsolateImpl->TerminateExecution(false);
+    }
+}
