+size_t V8IsolateImpl::Ssrs2CountedSize(v8::HeapStatistics& heapStatistics)
+{
+    // SSRS2 (0018): what the soft limit (MaxHeapSize) counts: the heap, and the memory V8 accounts for outside it other
+    // than ArrayBuffers' (which MaxArrayBufferAllocation bounds on its own): WebAssembly memories, compiled WebAssembly
+    // modules, external strings. A page's WebAssembly memories were bounded by nothing (six of 1 GB, or one 64-bit one
+    // of 8 GB, filled: the process's memory grew by as much, and several such renders at once ended it).
+    auto external = v8::ExternalMemoryAccounter::GetTotalAmountOfExternalAllocatedMemoryForTesting(m_upIsolate.get());
+    auto buffers = static_cast<int64_t>(heapStatistics.external_memory());
+    return heapStatistics.total_heap_size() + ((external > buffers) ? static_cast<size_t>(external - buffers) : 0);
+}
