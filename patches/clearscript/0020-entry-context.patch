+// The context a promise job runs in (0020): entryGlobal() answers, while V8 runs its microtasks, the global of the context
+// V8 runs the job in, or of one entered since (v8::Isolate::GetEnteredOrMicrotaskContext: a job's context is its callback's
+// realm), and null outside them. V8 runs a job after the host call that queued it returned, where the host no longer
+// knows which window's script runs: HTML's entry settings object of a promise job is its callback's realm (§8.1.7.3,
+// HostEnqueuePromiseJob), which the host reads here. globalThis[holder][name] made entryGlobal, from inside a host
+// call: 1 when made, 0 outside a context.
+static void Ssrs2EntryGlobal(const v8::FunctionCallbackInfo<v8::Value>& info)
+{
+    auto isolate = info.GetIsolate();
+    if (!v8::MicrotasksScope::IsRunningMicrotasks(isolate))
+    {
+        info.GetReturnValue().SetNull();
+        return;
+    }
+    auto entered = isolate->GetEnteredOrMicrotaskContext();
+    if (entered.IsEmpty())
+    {
+        info.GetReturnValue().SetNull();
+        return;
+    }
+    info.GetReturnValue().Set(entered->Global());
+}
+
+NATIVE_ENTRY_POINT(int) Ssrs2_InstallEntryContext(const char* holder, const char* name) noexcept
+{
+    auto isolate = v8::Isolate::TryGetCurrent();
+    if (isolate == nullptr || !isolate->InContext() || holder == nullptr || name == nullptr)
+    {
+        return 0;
+    }
+    v8::HandleScope scope(isolate);
+    auto context = isolate->GetCurrentContext();
+    auto object = Ssrs2Holder(isolate, context, holder);
+    v8::Local<v8::Function> function;
+    if (object.IsEmpty() || !v8::Function::New(context, Ssrs2EntryGlobal, v8::Local<v8::Value>(), 0, v8::ConstructorBehavior::kThrow).ToLocal(&function))
+    {
+        return 0;
+    }
+    return object->Set(context, v8::String::NewFromUtf8(isolate, name).ToLocalChecked(), function).IsJust() ? 1 : 0;
+}
