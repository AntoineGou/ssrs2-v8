+    // (0043: a slot's function knows its slot, a function of a table of them: V8's data for the function is read only
+    // by the slots past the table)
+    template <int K> static void Slot(const v8::FunctionCallbackInfo<v8::Value>& info) { CallSlot(K, info); }
+    static void Callback(const v8::FunctionCallbackInfo<v8::Value>& info) { CallSlot(info.Data().As<v8::Int32>()->Value(), info); }
+    template <size_t... I> static constexpr std::array<v8::FunctionCallback, sizeof...(I)> Slots(std::index_sequence<I...>) { return { { &Slot<static_cast<int>(I)>... } }; }
+    static constexpr auto kSlots = Slots(std::make_index_sequence<4096>{});
+    static v8::FunctionCallback CallbackOf(int32_t slot) { return slot >= 0 && static_cast<size_t>(slot) < kSlots.size() ? kSlots[static_cast<size_t>(slot)] : Callback; }
