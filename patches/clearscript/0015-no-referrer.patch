index d4964c5..5ed01e7 100644
--- a/ClearScriptV8/V8SplitProxyNative.cpp
+++ b/ClearScriptV8/V8SplitProxyNative.cpp
@@ -2753,6 +2753,16 @@ NATIVE_ENTRY_POINT(int) Ssrs2_InstallUndetectable(const char* holder, const char
     return 1;
 }
 
+// The resource name of the host's stand-in script for "no referrer" (0015): a dynamic import whose referrer the context no
+// longer knows is loaded with the document info of the script a live holder keeps under this name (the host's loader
+// resolves it against the running task's document). Every isolate's; null or empty: none, the import fails as before.
+namespace Ssrs2NoReferrer { void Set(const char* name); }
+NATIVE_ENTRY_POINT(int) Ssrs2_SetNoReferrerName(const char* name) noexcept
+{
+    Ssrs2NoReferrer::Set(name);
+    return 1;
+}
