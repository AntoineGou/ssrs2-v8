diff --git a/ClearScriptV8/V8SplitProxyNative.cpp b/ClearScriptV8/V8SplitProxyNative.cpp
index 2a341c3c..d61f2911 100644
--- a/ClearScriptV8/V8SplitProxyNative.cpp
+++ b/ClearScriptV8/V8SplitProxyNative.cpp
@@ -269,8 +269,34 @@ NATIVE_ENTRY_POINT(void) Memory_Free(const void* pMemory) noexcept
 
 //-----------------------------------------------------------------------------
 
+// SSRS2 (tools/V8): the ICU data of the V8 this library is built with, inside it. ClearScript's ICU data package
+// holds its own V8's: another ICU version fails Intl's calls ("Internal error. Icu error.").
+#if defined(__APPLE__)
+__asm__(".section __TEXT,__const\n.p2align 4\n.globl _ssrs2_icu_data\n_ssrs2_icu_data:\n.incbin \"V8/icudtl.dat\"\n.globl _ssrs2_icu_data_end\n_ssrs2_icu_data_end:\n.text\n");
+#define SSRS2_ICU_DATA
+#elif defined(__linux__)
+__asm__(".section .rodata\n.p2align 4\n.globl ssrs2_icu_data\nssrs2_icu_data:\n.incbin \"V8/icudtl.dat\"\n.globl ssrs2_icu_data_end\nssrs2_icu_data_end:\n.text\n");
+#define SSRS2_ICU_DATA
+#elif defined(_WIN32) && defined(__clang__)
+// (ClearScript's ClangCL projects compile from their folder, ClearScriptV8\win-<cpu>; x86 decorates C names with _)
+#if defined(_M_IX86)
+__asm__(".section .rdata,\"dr\"\n.p2align 4\n.globl _ssrs2_icu_data\n_ssrs2_icu_data:\n.incbin \"../../V8/icudtl.dat\"\n.globl _ssrs2_icu_data_end\n_ssrs2_icu_data_end:\n.text\n");
+#else
+__asm__(".section .rdata,\"dr\"\n.p2align 4\n.globl ssrs2_icu_data\nssrs2_icu_data:\n.incbin \"../../V8/icudtl.dat\"\n.globl ssrs2_icu_data_end\nssrs2_icu_data_end:\n.text\n");
+#endif
+#define SSRS2_ICU_DATA
+#endif
+#ifdef SSRS2_ICU_DATA
+extern "C" const char ssrs2_icu_data[];
+extern "C" const char ssrs2_icu_data_end[];
+#endif
+
 NATIVE_ENTRY_POINT(void) V8Environment_InitializeICU(const char* pICUData, uint32_t size) noexcept
 {
+#ifdef SSRS2_ICU_DATA
+    pICUData = ssrs2_icu_data;
+    size = static_cast<uint32_t>(ssrs2_icu_data_end - ssrs2_icu_data);
+#endif
     ASSERT_EVAL(v8::V8::InitializeICU(pICUData, size));
 }
 
