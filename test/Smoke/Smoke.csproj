<Project Sdk="Microsoft.NET.Sdk">
  <!-- Loads a library built here (SSRS2.ClearScriptV8.<rid>) through the managed assemblies built here and runs
       smoke.js: -p:ClearScriptManaged=<folder> names build-managed.sh's out-managed/lib/net8.0. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="SSRS2.ClearScript.Core" HintPath="$(ClearScriptManaged)/SSRS2.ClearScript.Core.dll" />
    <Reference Include="SSRS2.ClearScript.V8" HintPath="$(ClearScriptManaged)/SSRS2.ClearScript.V8.dll" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <None Include="smoke.js;expected.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
