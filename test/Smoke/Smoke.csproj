<Project Sdk="Microsoft.NET.Sdk">
  <!-- Loads a ClearScriptV8 library built here through ClearScript's managed side (no native package) and runs smoke.js.
       -p:ClearScriptManaged=<folder>: the managed assemblies build-managed.sh made (its out-managed/lib/net8.0), in
       place of ClearScript's package: the pair a release carries, tested together. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.ClearScript.V8" Version="7.5.1.1" Condition="'$(ClearScriptManaged)' == ''" />
    <None Include="smoke.js;expected.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(ClearScriptManaged)' != ''">
    <Reference Include="ClearScript.Core" HintPath="$(ClearScriptManaged)/ClearScript.Core.dll" />
    <Reference Include="ClearScript.V8" HintPath="$(ClearScriptManaged)/ClearScript.V8.dll" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
